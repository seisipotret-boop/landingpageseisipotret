---
// src/components/Services.astro

const services = [
  {
    id: 'pelataran-mekkah',
    title: 'Pelataran Mekkah',
    desc: 'Layanan dokumentasi foto & video profesional di area sekitar pelataran Masjidil Haram dengan estetika sinematik.',
    image: 'https://images.pexels.com/photos/15501955/pexels-photo-15501955.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=600&w=800',
    badge: 'Populer',
  },
  {
    id: 'jabal-kudai',
    title: 'Jabal Kudai Package',
    desc: 'Sesi pemotretan eksklusif dari ketinggian Jabal Kudai dengan latar belakang pemandangan megah Landmark Kota Mekkah.',
    image: 'https://images.pexels.com/photos/15369686/pexels-photo-15369686.jpeg?q=80&w=600&auto=format&fit=crop',
    badge: null,
  },
  {
    id: 'jabal-khandamah',
    title: 'Jabal Khandamah',
    desc: 'Dokumentasi panorama dari puncak Jabal Khandamah yang mengabadikan keindahan lanskap kota suci secara utuh.',
    image: 'https://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=600&auto=format&fit=crop',
    badge: null,
  },
  {
    id: 'travel-package',
    title: 'Travel Package',
    desc: 'Paket liputan lengkap perjalanan spiritual khusus untuk rombongan jamaah umroh maupun agensi perjalan travel.',
    image: 'https://images.pexels.com/photos/38335976/pexels-photo-38335976.jpeg?q=80&w=600&auto=format&fit=crop',
    badge: 'Full Trip',
  },
];
---

<section id="layanan" class="py-20 bg-slate-100/50 dark:bg-slate-950 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-[#4a88bc] block">
          LAYANAN KAMI
        </span>
        <h2 class="text-3xl md:text-5xl font-serif text-slate-900 dark:text-white tracking-tight">
          Pilihan Paket <span class="italic text-[#4a88bc]">Dokumentasi</span>
        </h2>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md font-light leading-relaxed">
        Setiap paket dirancang untuk mengabadikan setiap momen berharga perjalanan ibadah suci Anda dengan hasil yang artistik, eksklusif, dan elegan.
      </p>
    </div>

    <!-- Horizontal 4-Column Grid Layout -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <a 
          href={`/layanan/${service.id}`}
          class="group relative h-[420px] rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between p-6 transform hover:-translate-y-1"
        >
          <!-- Background Image -->
          <img 
            src={service.image} 
            alt={service.title} 
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700 ease-out"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent transition-opacity group-hover:opacity-90"></div>

          <!-- Top Badge / Arrow Indicator -->
          <div class="relative z-10 flex items-center justify-between">
            {service.badge ? (
              <span class="px-3 py-1 rounded-full bg-[#4a88bc] text-white font-semibold text-[10px] uppercase tracking-wider shadow-md">
                {service.badge}
              </span>
            ) : (
              <div></div>
            )}
            
            <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md text-white flex items-center justify-center group-hover:bg-[#4a88bc] group-hover:scale-110 transition-all duration-300 shadow-lg">
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </div>

          <!-- Card Content -->
          <div class="relative z-10 text-white space-y-2">
            <h3 class="text-xl font-bold tracking-tight group-hover:text-[#4a88bc] transition-colors duration-300">
              {service.title}
            </h3>
            <p class="text-xs text-slate-200 font-light leading-relaxed line-clamp-3">
              {service.desc}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>