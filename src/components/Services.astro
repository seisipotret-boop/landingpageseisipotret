---
// src/components/Services.astro

const services = [
  {
    id: "pelataran-makkah",
    title: "Makkah",
    desc: "Dokumentasi foto & video profesional di area sekitar pelataran Masjidil Haram dengan estetika sinematik.",
    image:
      "https://wallpapers.com/images/hd/skyscrapers-and-hajj-crowd-in-makkah-hd-fwavjaoaj55qbzlb.jpg?auto=compress&cs=tinysrgb&dpr=2&h=600&w=800",
  },
  {
    id: "pelataran-madinah",
    title: "Madinah",
    desc: "Abadikan momen syahdu di sekitar area Masjid Nabawi dengan latar payung raksasa dan pencahayaan alami.",
    image:
      "https://raw.githubusercontent.com/seisipotret-boop/seisipotret-galeri/refs/heads/main/Pelataran_Madinah_Masjid_Nabawi.webp",
  },
  {
    id: "jabal-kudai-khandamah",
    title: "Jabal Kudai & Khandamah",
    desc: "Pengambilan foto panorama mengabadikan megahnya lanskap Kota Makkah dari puncak ketinggian.",
    image:
      "https://raw.githubusercontent.com/seisipotret-boop/seisipotret-galeri/refs/heads/main/Jabal_Kudai_Khandamah.webp?q=80&w=600&auto=format&fit=crop",
  },

  {
    id: "alula",
    title: "ALULA",
    desc: "Sesi pemotretan eksotis di tengah keajaiban warisan sejarah dan tebing batu megah Al-Ula.",
    image:
      "https://raw.githubusercontent.com/seisipotret-boop/seisipotret-galeri/refs/heads/main/AlUla_ElephantRock.webp?q=80&w=600&auto=format&fit=crop",
  },
  {
    id: "mathaf-kabah",
    title: "Mathaf & Ka'bah",
    desc: "Dokumentasi privat dan sakral berlatar keagungan area Mathaf & Ka'bah secara eksklusif.",
    image:
      "https://images.pexels.com/photos/15369686/pexels-photo-15369686.jpeg?q=80&w=600&auto=format&fit=crop",
  },
  {
    id: "quba-mosque",
    title: "Quba Mosque",
    desc: "Sesi foto bernilai sejarah di Masjid Quba, masjid pertama yang dibangun Rasulullah SAW di Madinah.",
    image:
      "https://images.pexels.com/photos/30220899/pexels-photo-30220899/free-photo-of-masjid-quba-yang-megah-dengan-latar-langit-biru-yang-cerah.jpeg?q=80&w=600&auto=format&fit=crop",
  },
  {
    id: "jabal-uhud",
    title: "Jabal Uhud",
    desc: "Sesi foto bernilai sejarah di Bukit Uhud, Madinah, mengabadikan momen berharga penuh makna.",
    image:
      "https://raw.githubusercontent.com/seisipotret-boop/seisipotret-galeri/refs/heads/main/Jabal_Uhud_View_Point.webp?q=80&w=600&auto=format&fit=crop",
  },
];
---

<section
  id="lokasi"
  class="py-20 bg-slate-100/50 dark:bg-slate-900/50 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="space-y-2">
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#4a88bc]">
          LOKASI DOKUMENTASI
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white mt-2">
          Destinasi <span class="italic text-[#4a88bc]">Pilihan</span>
        </h2>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md font-light leading-relaxed">
        Setiap lokasi memiliki keindahan dan estetika tersendiri. Pilihlah
        destinasi impian Anda untuk diabadikan secara profesional.
      </p>
    </div>

    <!-- Unified Responsive Grid Container -->
    <!-- Mobile: 1 kolom | Tablet: 2 kolom (2-2-2-1) | Desktop: 12 kolom (3-3-3 di baris 1, 4-4-4-4 di baris 2) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-6">
      {services.map((service, index) => (
        <a
          href={`/layanan/${service.id}`}
          class={`group relative h-[380px] w-full rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between p-6 transform hover:-translate-y-1 block ${
            index < 3 ? "lg:col-span-4" : "lg:col-span-3"
          }`}
        >
          <!-- Background Image -->
          <img
            src={service.image}
            alt={service.title}
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
          />
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent transition-opacity group-hover:opacity-90"></div>

          <!-- Top Badge / Arrow Indicator -->
          <div class="relative z-10 flex items-center justify-between">
            <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md text-white flex items-center justify-center group-hover:bg-[#4a88bc] group-hover:scale-110 transition-all duration-300 shadow-lg">
              <svg
                class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Card Content -->
          <div class="relative z-10 text-white space-y-2">
            <h3 class="text-xl font-bold tracking-tight group-hover:text-[#4a88bc] transition-colors duration-300">
              {service.title}
            </h3>
            <p class="text-xs text-slate-200 font-light leading-relaxed line-clamp-3">
              {service.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
