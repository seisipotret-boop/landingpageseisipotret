---
// src/components/Navbar.astro
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const serviceItems = [
  {
    id: "01",
    title: "Pelataran Mekkah",
    desc: "Dokumentasi eksklusif di area pelataran Masjidil Haram",
    href: "/layanan/pelataran-makkah",
  },
  {
    id: "02",
    title: "Pelataran Madinah",
    desc: "Sesi foto & video cinematic sudut pandang Jabal Kudai",
    href: "/layanan/pelataran-madinah",
  },
  {
    id: "03",
    title: "Al-`Ula",
    desc: "Sesi dokumentasi panorama citylight dari puncak Jabal Khandamah",
    href: "/layanan/alula",
  },
  {
    id: "04",
    title: "Jabal Kudai & Khandamah",
    desc: "Liputan perjalanan dokumentasi menyeluruh untuk grup & travel",
    href: "/layanan/jabal-kudai-khandamah",
  },
  {
    id: "05",
    title: "Jabal Uhud",
    desc: "Paket dokumentasi eksklusif untuk grup & travel",
    href: "/layanan/jabal-uhud",
  },
];
const ctaMessage = `Halo Seisi Potret, saya tertarik untuk konsultasi layanan dokumentasi di SeisiPotret.
Rencana perjalanan saya:
- Makkah/Madinah: 
- Tanggal perjalanan: 
- Jumlah peserta: 
Boleh dibantu informasinya mengenai paket dan ketersediaan jadwal?`;
const nowhatsappNumber = "6285163096956";
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 md:py-5"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/"
      class="font-serif text-lg md:text-xl font-bold tracking-widest text-slate-900 dark:text-white uppercase hover:text-[#4a88bc] transition-colors duration-300"
    >
      SEISIPOTRET
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-700 dark:text-slate-200">
      <a
        href="/"
        class={`relative py-1 transition-colors duration-300 hover:text-[#4a88bc] ${currentPath === "" ? "text-[#4a88bc] font-semibold" : ""}`}
      >
        Beranda
      </a>

      <!-- Dropdown Layanan (Desktop) -->
      <div class="relative group cursor-pointer">
        <button class="flex items-center gap-1 hover:text-[#4a88bc] transition py-2 font-medium">
          Layanan
          <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180 text-slate-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>

        <!-- Menu Dropdown Box Desktop -->
        <div class="absolute top-full -left-6 hidden group-hover:block w-80 bg-white dark:bg-slate-900 shadow-2xl rounded-3xl p-3 border border-slate-200/80 dark:border-slate-800 transition-all duration-300">
          <div class="space-y-1">
            {serviceItems.map((item) => (
              <a
                href={item.href}
                class="group/item flex items-start justify-between p-3.5 rounded-2xl hover:bg-slate-100 dark:hover:bg-slate-800/80 transition-all duration-200"
              >
                <div class="space-y-0.5 pr-2">
                  <h4 class="text-sm font-bold text-slate-900 dark:text-white group-hover/item:text-[#4a88bc] transition-colors">
                    {item.title}
                  </h4>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 font-light leading-snug">
                    {item.desc}
                  </p>
                </div>
                <svg
                  class="w-4 h-4 text-slate-400 group-hover/item:text-[#4a88bc] group-hover/item:translate-x-0.5 group-hover/item:-translate-y-0.5 transition-transform shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 17L17 7M17 7H7M17 7v10"
                  ></path>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/tentang"
        class={`relative py-1 transition-colors duration-300 hover:text-[#4a88bc] ${currentPath === "/tentang" ? "text-[#4a88bc] font-semibold" : ""}`}
      >
        Tentang
      </a>

      <a
        href="/kontak"
        class={`relative py-1 transition-colors duration-300 hover:text-[#4a88bc] ${currentPath === "/kontak" ? "text-[#4a88bc] font-semibold" : ""}`}
      >
        Kontak
      </a>
    </nav>

    <!-- Desktop & Mobile Controls -->
    <div class="flex items-center space-x-3 md:space-x-4">
      <button
        id="theme-toggle"
        aria-label="Toggle Theme"
        class="p-2.5 rounded-full bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 transition-all duration-300 border border-slate-300/50 dark:border-slate-700/50 cursor-pointer"
      >
        <svg
          id="sun-icon"
          class="w-4 h-4 hidden dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="moon-icon"
          class="w-4 h-4 block dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <a
        href={`https://wa.me/${nowhatsappNumber}?text=${encodeURIComponent(ctaMessage)}`}
        target="_blank"
        class="hidden md:inline-flex items-center gap-2 border border-[#4a88bc] text-[#4a88bc] dark:text-white dark:border-white/30 px-6 py-2.5 rounded-full text-xs font-semibold tracking-wider hover:bg-[#4a88bc] hover:text-white transition-all duration-300 uppercase"
      >
        KONSULTASI
      </a>

      <button
        id="mobile-menu-btn"
        aria-label="Open Navigation Menu"
        class="md:hidden p-2.5 rounded-full bg-slate-200/80 dark:bg-slate-800/80 text-slate-800 dark:text-slate-100 cursor-pointer"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Overlay Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- Mobile Drawer Navigation -->
<aside
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 w-full max-w-md h-full bg-[#f6f5f2] dark:bg-slate-950 z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between p-6 md:hidden overflow-y-auto"
>
  <!-- Drawer Top Bar -->
  <div class="flex items-center justify-between pb-6 border-b border-slate-200/60 dark:border-slate-800/60">
    <a
      href="/"
      class="text-base font-bold tracking-widest text-slate-900 dark:text-white uppercase"
    >
      SEISIPOTRET
    </a>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle-mobile"
        aria-label="Toggle Theme"
        class="p-2.5 rounded-full bg-slate-200/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 cursor-pointer"
      >
        <svg
          class="w-4 h-4 hidden dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          class="w-4 h-4 block dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <button
        id="mobile-menu-close"
        aria-label="Close Navigation Menu"
        class="p-2.5 rounded-full bg-slate-200/80 dark:bg-slate-800/80 text-slate-800 dark:text-slate-100 cursor-pointer"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Links Navigation -->
  <nav class="py-6 space-y-2">
    <!-- 01 Beranda -->
    <div class="border-b border-slate-200/60 dark:border-slate-800/60 py-4">
      <a
        href="/"
        class="flex items-center justify-between text-2xl font-bold text-slate-900 dark:text-white hover:text-[#4a88bc] transition"
      >
        <div class="flex items-center gap-4">
          <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 tracking-wider">
            01
          </span>
          <span class={currentPath === "" ? "text-[#4a88bc]" : ""}>
            Beranda
          </span>
        </div>
        {currentPath === "" && (
          <span class="w-2.5 h-2.5 rounded-full bg-[#4a88bc]"></span>
        )}
      </a>
    </div>

    <!-- 02 Layanan (Accordion Expandable) -->
    <div class="border-b border-slate-200/60 dark:border-slate-800/60 py-4">
      <button
        id="mobile-layanan-btn"
        class="w-full flex items-center justify-between text-2xl font-bold text-slate-900 dark:text-white hover:text-[#4a88bc] transition"
      >
        <div class="flex items-center gap-4">
          <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 tracking-wider">
            02
          </span>
          <span>Layanan</span>
        </div>
        <svg
          id="mobile-layanan-chevron"
          class="w-5 h-5 text-slate-500 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"
          ></path>
        </svg>
      </button>

      <!-- Submenu Layanan (Muncul Saat Tap Layanan) -->
      <div id="mobile-layanan-submenu" class="hidden pl-10 pt-4 space-y-3.5">
        {serviceItems.map((sub) => (
          <a
            href={sub.href}
            class="flex items-center gap-3 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-[#4a88bc] transition"
          >
            <span class="text-[11px] text-slate-400 font-mono">{sub.id}</span>
            <span>{sub.title}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- 03 Tentang -->
    <div class="border-b border-slate-200/60 dark:border-slate-800/60 py-4">
      <a
        href="/tentang"
        class="flex items-center justify-between text-2xl font-bold text-slate-900 dark:text-white hover:text-[#4a88bc] transition"
      >
        <div class="flex items-center gap-4">
          <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 tracking-wider">
            03
          </span>
          <span class={currentPath === "/tentang" ? "text-[#4a88bc]" : ""}>
            Tentang
          </span>
        </div>
        {currentPath === "/tentang" && (
          <span class="w-2.5 h-2.5 rounded-full bg-[#4a88bc]"></span>
        )}
      </a>
    </div>

    <!-- 04 Kontak -->
    <div class="border-b border-slate-200/60 dark:border-slate-800/60 py-4">
      <a
        href="/kontak"
        class="flex items-center justify-between text-2xl font-bold text-slate-900 dark:text-white hover:text-[#4a88bc] transition"
      >
        <div class="flex items-center gap-4">
          <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 tracking-wider">
            04
          </span>
          <span class={currentPath === "/kontak" ? "text-[#4a88bc]" : ""}>
            Kontak
          </span>
        </div>
        {currentPath === "/kontak" && (
          <span class="w-2.5 h-2.5 rounded-full bg-[#4a88bc]"></span>
        )}
      </a>
    </div>
  </nav>

  <!-- Mobile Drawer Bottom CTA -->
  <div class="space-y-4 pt-4">
    <a
      href="https://wa.me/6285163096956"
      target="_blank"
      class="w-full py-4 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 shadow-md"
    >
      KONSULTASI SEKARANG ↗
    </a>

    <div class="grid grid-cols-3 gap-2 pt-2">
      <a
        href="https://wa.me/6285163096956"
        target="_blank"
        class="p-3 rounded-2xl bg-slate-200/60 dark:bg-slate-900 text-center flex flex-col items-center gap-1"
      >
        <span class="text-[9px] font-bold text-slate-600 dark:text-slate-400 uppercase">
          WHATSAPP
        </span>
      </a>
      <a
        href="mailto:seisipotret@gmail.com"
        class="p-3 rounded-2xl bg-slate-200/60 dark:bg-slate-900 text-center flex flex-col items-center gap-1"
      >
        <span class="text-[9px] font-bold text-slate-600 dark:text-slate-400 uppercase">
          EMAIL
        </span>
      </a>
      <a
        href="https://instagram.com"
        target="_blank"
        class="p-3 rounded-2xl bg-slate-200/60 dark:bg-slate-900 text-center flex flex-col items-center gap-1"
      >
        <span class="text-[9px] font-bold text-slate-600 dark:text-slate-400 uppercase">
          INSTAGRAM
        </span>
      </a>
    </div>
  </div>
</aside>

<script>
  function setupNavbar() {
    const navbar = document.getElementById("navbar");
    const themeToggle = document.getElementById("theme-toggle");
    const themeToggleMobile = document.getElementById("theme-toggle-mobile");
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenuClose = document.getElementById("mobile-menu-close");
    const mobileMenuDrawer = document.getElementById("mobile-menu-drawer");
    const mobileMenuBackdrop = document.getElementById("mobile-menu-backdrop");

    const mobileLayananBtn = document.getElementById("mobile-layanan-btn");
    const mobileLayananSubmenu = document.getElementById(
      "mobile-layanan-submenu",
    );
    const mobileLayananChevron = document.getElementById(
      "mobile-layanan-chevron",
    );

    // 1. SCROLL NAVBAR
    function handleScroll() {
      if (!navbar) return;
      if (window.scrollY > 20) {
        navbar.classList.add(
          "bg-[#f6f5f2]/80",
          "dark:bg-slate-950/80",
          "backdrop-blur-md",
          "border-b",
          "border-slate-200/50",
          "dark:border-slate-800/50",
          "shadow-sm",
          "py-3",
          "md:py-3.5",
        );
        navbar.classList.remove("py-4", "md:py-5");
      } else {
        navbar.classList.remove(
          "bg-[#f6f5f2]/80",
          "dark:bg-slate-950/80",
          "backdrop-blur-md",
          "border-b",
          "border-slate-200/50",
          "dark:border-slate-800/50",
          "shadow-sm",
          "py-3",
          "md:py-3.5",
        );
        navbar.classList.add("py-4", "md:py-5");
      }
    }

    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // 2. ACCORDION MOBILE LAYANAN
    if (mobileLayananBtn) {
      mobileLayananBtn.onclick = () => {
        mobileLayananSubmenu?.classList.toggle("hidden");
        mobileLayananChevron?.classList.toggle("rotate-180");
      };
    }

    // 3. TOGGLE THEME
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    }

    if (themeToggle) themeToggle.onclick = toggleTheme;
    if (themeToggleMobile) themeToggleMobile.onclick = toggleTheme;

    // 4. MOBILE DRAWER NAVIGATION
    const closeMenu = () => {
      mobileMenuDrawer?.classList.add("translate-x-full");
      mobileMenuBackdrop?.classList.add("opacity-0", "pointer-events-none");
    };

    if (mobileMenuBtn) {
      mobileMenuBtn.onclick = () => {
        mobileMenuDrawer?.classList.remove("translate-x-full");
        mobileMenuBackdrop?.classList.remove(
          "opacity-0",
          "pointer-events-none",
        );
      };
    }

    if (mobileMenuClose) mobileMenuClose.onclick = closeMenu;
    if (mobileMenuBackdrop) mobileMenuBackdrop.onclick = closeMenu;
  }

  document.addEventListener("astro:page-load", setupNavbar);
</script>
