---
// src/components/Gallery.astro

const portfolioItems = [
  {
    id: 1,
    title: "Pelataran Masjidil Haram",
    location: "makkah",
    type: "single", // Filter foto: single, couple, family
    media: "foto",
    tag: "MAKKAH · SINGLE",
    image:
      "https://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=800&auto=format&fit=crophttps://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=800&auto=format&fit=crop",
  },
  {
    id: 2,
    title: "Panorama Jabal Elephant Rock",
    location: "al-ula",
    type: "single",
    media: "foto",
    tag: "AL-ULA · SINGLE",
    image:
      "https://images.pexels.com/photos/15369686/pexels-photo-15369686.jpeg?q=80&w=800&auto=format&fit=crop?q=80&w=1200&auto=format&fit=crop",
  },
  {
    id: 3,
    title: "Sesi Pasangan Jabal Khandamah",
    location: "jabal",
    type: "couple",
    media: "foto",
    tag: "JABAL KHANDAMAH · COUPLE",
    image:
      "https://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=800&auto=format&fit=cropq=80&w=1200&auto=format&fit=crop",
  },
  {
    id: 4,
    title: "Dokumentasi Keluarga Masjid Nabawi",
    location: "madinah",
    type: "family",
    media: "foto",
    tag: "MADINAH · FAMILY",
    image:
      "https://images.unsplash.com/photo-1580418827493-f2b22c0a76cb?q=80&w=1200&auto=format&fit=crop",
  },
  {
    id: 5,
    title: "Video Cinematic Umroh VVIP",
    location: "makkah",
    type: "cinematic", // Filter video: cinematic, testimonial
    media: "video",
    tag: "MAKKAH · CINEMATIC",
    videoUrl: "/media/07044.mp4",
    image:
      "https://images.pexels.com/photos/38335976/pexels-photo-38335976.jpeg?q=80&w=800&auto=format&fit=crop",
  },
  {
    id: 6,
    title: "Kesan Jamaah Umrah Family",
    location: "madinah",
    type: "testimonial",
    media: "video",
    tag: "MADINAH · TESTIMONIAL",
    videoUrl: "/media/herovideo.mp4",
    image:
      "https://images.pexels.com/photos/15501955/pexels-photo-15501955.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=800&w=600",
  },
];
---

<section
  id="galeri"
  class="py-20 bg-slate-100/50 dark:bg-slate-900/50 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Header Section -->
    <div class="text-center space-y-4 mb-10">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-[#4a88bc]"></span>
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#4a88bc]">
          PORTFOLIO
        </span>
        <span class="h-px w-8 bg-[#4a88bc]"></span>
      </div>

      <h2 class="text-3xl md:text-5xl font-serif text-slate-900 dark:text-white tracking-tight">
        Dokumentasi Keindahan{" "}
        <span class="italic font-normal text-[#4a88bc]">Tanah Suci</span>
      </h2>

      <p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 max-w-lg mx-auto font-light leading-relaxed">
        Saring galeri di bawah ini untuk melihat hasil tangkapan foto sinematik
        dan video premium kami.
      </p>
    </div>

    <!-- Filter Buttons Section -->
    <div class="flex flex-col items-center gap-4 mb-12">
      <!-- Filter Jenis Media (Foto / Video) -->
      <div class="inline-flex p-1 rounded-full bg-slate-200/80 dark:bg-slate-900 border border-slate-300/60 dark:border-slate-800 shadow-inner">
        <button
          data-filter-media="foto"
          class="filter-media-btn active-media px-6 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 bg-[#4a88bc] text-white shadow-md"
        >
          FOTO
        </button>
        <button
          data-filter-media="video"
          class="filter-media-btn px-6 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
        >
          VIDEO
        </button>
      </div>

      <!-- Filter Lokasi -->
      <div class="flex flex-wrap items-center justify-center gap-2 max-w-3xl">
        <button
          data-filter-loc="all"
          class="filter-loc-btn active-pill px-4 py-1.5 rounded-full text-xs border border-[#4a88bc] bg-[#4a88bc] text-white transition-all shadow-sm"
        >
          Semua Lokasi
        </button>
        <button
          data-filter-loc="makkah"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Makkah
        </button>
        <button
          data-filter-loc="madinah"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Madinah
        </button>
        <button
          data-filter-loc="al-ula"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Al-Ula
        </button>
        <button
          data-filter-loc="jabal"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Jabal Kudai & Khandamah
        </button>
      </div>

      <!-- Filter Tipe (Dinamis: Foto = Single, Couple, Family | Video = Cinematic, Testimonial) -->
      <div
        id="type-filter-container"
        class="flex flex-wrap items-center justify-center gap-2"
      >
        <button
          data-filter-type="all"
          class="filter-type-btn active-pill px-4 py-1.5 rounded-full text-xs border border-[#4a88bc] bg-[#4a88bc] text-white transition-all shadow-sm"
        >
          Semua Tipe
        </button>
        <button
          data-filter-type="single"
          class="type-photo-btn filter-type-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Single
        </button>
        <button
          data-filter-type="couple"
          class="type-photo-btn filter-type-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Couple
        </button>
        <button
          data-filter-type="family"
          class="type-photo-btn filter-type-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Family
        </button>

        <button
          data-filter-type="cinematic"
          class="type-video-btn filter-type-btn hidden px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Cinematic
        </button>
        <button
          data-filter-type="testimonial"
          class="type-video-btn filter-type-btn hidden px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all"
        >
          Testimonial
        </button>
      </div>
    </div>

    <!-- 3D Carousel Gallery Container -->
    <div class="relative max-w-5xl mx-auto h-[480px] md:h-[540px] flex items-center justify-center">
      <div
        id="gallery-carousel"
        class="w-full h-full relative flex items-center justify-center overflow-hidden"
      >
        {portfolioItems.map((item, index) => (
          <div
            data-index={index}
            data-media={item.media}
            data-loc={item.location}
            data-type={item.type}
            data-video-url={item.videoUrl}
            class="gallery-card absolute transition-all duration-500 ease-out cursor-pointer rounded-3xl overflow-hidden shadow-2xl border border-slate-200/60 dark:border-slate-800 select-none bg-slate-900 group"
            style="width: 280px; height: 420px;"
          >
            {item.media === "video" ? (
              <>
                <video
                  data-src={item.videoUrl}
                  poster={item.image}
                  loop
                  muted
                  playsinline
                  preload="none"
                  class="w-full h-full object-cover pointer-events-none"
                />

                <!-- Play Button Overlay untuk Card Video -->
                <div class="play-trigger-btn absolute inset-0 flex items-center justify-center bg-slate-950/20 group-hover:bg-slate-950/40 transition-all z-10">
                  <div class="w-14 h-14 rounded-full bg-slate-900/70 backdrop-blur-md border border-white/30 flex items-center justify-center text-white shadow-xl transform group-hover:scale-110 transition-transform">
                    <svg
                      class="w-6 h-6 fill-current translate-x-0.5"
                      viewBox="0 0 24 24"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              </>
            ) : (
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            )}

            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>

            <!-- Tag Badge -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 w-max max-w-[90%] text-center pointer-events-none">
              <span class="inline-block px-3.5 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-md border border-white/20 text-[10px] font-semibold uppercase tracking-widest text-white shadow-lg">
                {item.tag}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Carousel Controls -->
    <div class="flex items-center justify-center gap-8 mt-6">
      <button
        id="prev-btn"
        class="flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 hover:text-[#4a88bc] transition-colors"
      >
        <div class="w-12 h-12 rounded-full border border-slate-300 dark:border-slate-800 flex items-center justify-center group-hover:border-[#4a88bc] group-hover:bg-[#4a88bc] group-hover:text-white transition-all shadow-sm">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            ></path>
          </svg>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-widest">
          PREVIOUS
        </span>
      </button>

      <!-- Dots Indicators -->
      <div id="carousel-dots" class="flex items-center gap-2"></div>

      <button
        id="next-btn"
        class="flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 hover:text-[#4a88bc] transition-colors"
      >
        <div class="w-12 h-12 rounded-full border border-slate-300 dark:border-slate-800 flex items-center justify-center group-hover:border-[#4a88bc] group-hover:bg-[#4a88bc] group-hover:text-white transition-all shadow-sm">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-widest">
          NEXT
        </span>
      </button>
    </div>
  </div>
</section>

<!-- Fullscreen Video Lightbox Modal (Reels Style) -->
<div
  id="video-modal"
  class="fixed inset-0 z-50 hidden opacity-0 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md transition-opacity duration-300"
>
  <div class="relative w-full max-w-[380px] md:max-w-[420px] aspect-[9/16] max-h-[88vh] rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-900 flex items-center justify-center transform scale-95 transition-transform duration-300">
    <!-- Close Button (Sesuai Referensi Design) -->
    <button
      id="close-modal-btn"
      class="absolute top-4 right-4 z-30 w-10 h-10 rounded-full bg-black/40 hover:bg-black/70 backdrop-blur-md border border-white/20 flex items-center justify-center text-white transition-colors"
      aria-label="Close video"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>

    <!-- Modal Player Video -->
    <video
      id="modal-video-player"
      controls
      autoplay
      playsinline
      class="w-full h-full object-cover rounded-3xl"
    >
      <source src="" type="video/mp4" />
    </video>
  </div>
</div>

<script>
  let activeIndex = 0;
  let visibleCards: HTMLElement[] = [];

  function initGallery() {
    const cards = Array.from(
      document.querySelectorAll(".gallery-card"),
    ) as HTMLElement[];
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const dotsContainer = document.getElementById("carousel-dots");

    const videoModal = document.getElementById("video-modal");
    const modalVideoPlayer = document.getElementById(
      "modal-video-player",
    ) as HTMLVideoElement | null;
    const closeModalBtn = document.getElementById("close-modal-btn");

    function filterAndRender() {
      const activeMedia =
        document
          .querySelector(".filter-media-btn.active-media")
          ?.getAttribute("data-filter-media") || "foto";
      const activeLoc =
        document
          .querySelector(".filter-loc-btn.active-pill")
          ?.getAttribute("data-filter-loc") || "all";
      const activeType =
        document
          .querySelector(".filter-type-btn.active-pill")
          ?.getAttribute("data-filter-type") || "all";

      // Switch ketersediaan tombol tipe filter
      const photoTypeBtns = document.querySelectorAll(".type-photo-btn");
      const videoTypeBtns = document.querySelectorAll(".type-video-btn");

      if (activeMedia === "video") {
        photoTypeBtns.forEach((btn) => btn.classList.add("hidden"));
        videoTypeBtns.forEach((btn) => btn.classList.remove("hidden"));
      } else {
        photoTypeBtns.forEach((btn) => btn.classList.remove("hidden"));
        videoTypeBtns.forEach((btn) => btn.classList.add("hidden"));
      }

      visibleCards = cards.filter((card) => {
        const mediaMatch = card.dataset.media === activeMedia;
        const locMatch = activeLoc === "all" || card.dataset.loc === activeLoc;
        const typeMatch =
          activeType === "all" || card.dataset.type === activeType;
        return mediaMatch && locMatch && typeMatch;
      });

      cards.forEach((card) => {
        card.style.display = "none";
        card.style.opacity = "0";
      });

      if (visibleCards.length === 0) return;

      if (activeIndex >= visibleCards.length) {
        activeIndex = 0;
      }

      renderCarousel();
      renderDots();
    }

    function renderCarousel() {
      if (visibleCards.length === 0) return;

      visibleCards.forEach((card, idx) => {
        card.style.display = "block";

        let offset = idx - activeIndex;

        if (offset < -Math.floor(visibleCards.length / 2)) {
          offset += visibleCards.length;
        } else if (offset > Math.floor(visibleCards.length / 2)) {
          offset -= visibleCards.length;
        }

        const videoElem = card.querySelector(
          "video",
        ) as HTMLVideoElement | null;

        if (offset === 0) {
          card.style.transform = "translateX(0%) scale(1.15)";
          card.style.zIndex = "30";
          card.style.opacity = "1";
          card.style.filter = "brightness(100%)";

          if (videoElem) {
            if (!videoElem.src && videoElem.dataset.src) {
              videoElem.src = videoElem.dataset.src;
            }
            videoElem.muted = true; // Autoplay muted di preview card
            videoElem.play().catch(() => {});
          }
        } else {
          if (
            offset === -1 ||
            (offset === visibleCards.length - 1 && visibleCards.length > 2)
          ) {
            card.style.transform = "translateX(-75%) scale(0.85)";
            card.style.zIndex = "20";
            card.style.opacity = "0.6";
            card.style.filter = "brightness(60%)";
          } else if (
            offset === 1 ||
            (offset === -(visibleCards.length - 1) && visibleCards.length > 2)
          ) {
            card.style.transform = "translateX(75%) scale(0.85)";
            card.style.zIndex = "20";
            card.style.opacity = "0.6";
            card.style.filter = "brightness(60%)";
          } else {
            card.style.transform = `translateX(${offset * 100}%) scale(0.5)`;
            card.style.zIndex = "10";
            card.style.opacity = "0";
          }

          if (videoElem && videoElem.src) {
            videoElem.pause();
          }
        }
      });
    }

    function renderDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = "";

      visibleCards.forEach((_, idx) => {
        const dot = document.createElement("button");
        dot.className = `h-1.5 rounded-full transition-all duration-300 ${
          idx === activeIndex
            ? "w-6 bg-[#4a88bc]"
            : "w-1.5 bg-slate-300 dark:bg-slate-700"
        }`;
        dot.addEventListener("click", () => {
          activeIndex = idx;
          renderCarousel();
          renderDots();
        });
        dotsContainer.appendChild(dot);
      });
    }

    // Modal Control Functions
    function openVideoModal(url: string) {
      if (!videoModal || !modalVideoPlayer) return;
      modalVideoPlayer.src = url;
      modalVideoPlayer.muted = false; // Aktifkan suara saat dibuka di modal full-screen

      videoModal.classList.remove("hidden");
      setTimeout(() => {
        videoModal.classList.remove("opacity-0");
        const contentBox = videoModal.querySelector("div");
        contentBox?.classList.remove("scale-95");
        contentBox?.classList.add("scale-100");
      }, 10);

      modalVideoPlayer.play().catch(() => {});
    }

    function closeVideoModal() {
      if (!videoModal || !modalVideoPlayer) return;

      const contentBox = videoModal.querySelector("div");
      contentBox?.classList.remove("scale-100");
      contentBox?.classList.add("scale-95");
      videoModal.classList.add("opacity-0");

      setTimeout(() => {
        videoModal.classList.add("hidden");
        modalVideoPlayer.pause();
        modalVideoPlayer.src = "";
      }, 300);
    }

    // Attach click events on video cards
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        if (card.dataset.media === "video" && card.dataset.videoUrl) {
          openVideoModal(card.dataset.videoUrl);
        }
      });
    });

    closeModalBtn?.addEventListener("click", closeVideoModal);
    videoModal?.addEventListener("click", (e) => {
      if (e.target === videoModal) closeVideoModal();
    });

    // Listeners Filter Media (Foto / Video)
    document.querySelectorAll(".filter-media-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        document.querySelectorAll(".filter-media-btn").forEach((b) => {
          b.classList.remove(
            "active-media",
            "bg-[#4a88bc]",
            "text-white",
            "shadow-md",
          );
          b.classList.add("text-slate-600", "dark:text-slate-400");
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add(
          "active-media",
          "bg-[#4a88bc]",
          "text-white",
          "shadow-md",
        );

        // Reset filter type ke 'all' saat ganti kategori foto/video
        document.querySelectorAll(".filter-type-btn").forEach((b) => {
          b.classList.remove("active-pill", "bg-[#4a88bc]", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        document
          .querySelector('.filter-type-btn[data-filter-type="all"]')
          ?.classList.add("active-pill", "bg-[#4a88bc]", "text-white");

        activeIndex = 0;
        filterAndRender();
      });
    });

    // Listeners Filter Lokasi
    document.querySelectorAll(".filter-loc-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        document.querySelectorAll(".filter-loc-btn").forEach((b) => {
          b.classList.remove("active-pill", "bg-[#4a88bc]", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add("active-pill", "bg-[#4a88bc]", "text-white");
        activeIndex = 0;
        filterAndRender();
      });
    });

    // Listeners Filter Tipe
    document.querySelectorAll(".filter-type-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        document.querySelectorAll(".filter-type-btn").forEach((b) => {
          b.classList.remove("active-pill", "bg-[#4a88bc]", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add("active-pill", "bg-[#4a88bc]", "text-white");
        activeIndex = 0;
        filterAndRender();
      });
    });

    // Prev / Next Controls
    prevBtn?.addEventListener("click", () => {
      if (visibleCards.length === 0) return;
      activeIndex =
        (activeIndex - 1 + visibleCards.length) % visibleCards.length;
      renderCarousel();
      renderDots();
    });

    nextBtn?.addEventListener("click", () => {
      if (visibleCards.length === 0) return;
      activeIndex = (activeIndex + 1) % visibleCards.length;
      renderCarousel();
      renderDots();
    });

    filterAndRender();
  }

  document.addEventListener("astro:page-load", initGallery);
</script>
