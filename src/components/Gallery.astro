---

<section id="galeri" class="py-20 bg-slate-100/50 dark:bg-slate-900/50 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Header -->
    <div class="text-center space-y-4 mb-10">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-[#4a88bc]"></span>
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#4a88bc]"> PORTFOLIO </span>
        <span class="h-px w-8 bg-[#4a88bc]"></span>
      </div>
      <h2 class="text-3xl md:text-5xl font-serif text-slate-900 dark:text-white tracking-tight">
        Dokumentasi Keindahan <span class="italic font-normal text-[#4a88bc]">Tanah Suci</span>
      </h2>
      <p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 max-w-lg mx-auto font-light leading-relaxed">
        Saring galeri di bawah ini untuk melihat hasil tangkapan foto sinematik dan video premium kami.
      </p>
    </div>

    <!-- Filter Controls -->
    <div class="flex flex-col items-center gap-4 mb-12">
      <!-- Filter Media -->
      <div class="inline-flex p-1 rounded-full bg-slate-200/80 dark:bg-slate-900 border border-slate-300/60 dark:border-slate-800 shadow-inner">
        <button
          data-filter-media="foto"
          class="filter-media-btn active-media px-6 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 bg-[#4a88bc] text-white shadow-md cursor-pointer"
        >
          FOTO
        </button>
        <button
          data-filter-media="video"
          class="filter-media-btn px-6 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all duration-300 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white cursor-pointer"
        >
          VIDEO
        </button>
      </div>

      <!-- Filter Lokasi -->
      <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl">
        <button
          data-filter-loc="all"
          class="filter-loc-btn active-pill px-4 py-1.5 rounded-full text-xs border border-[#4a88bc] bg-[#4a88bc] text-white transition-all shadow-sm cursor-pointer"
        >
          Semua Lokasi
        </button>
        <button
          data-filter-loc="makkah"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Makkah
        </button>
        <button
          data-filter-loc="kabah"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Ka'bah & Mathaf
        </button>
        <button
          data-filter-loc="madinah"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Madinah
        </button>
        <button
          data-filter-loc="quba"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Masjid Quba
        </button>
        <button
          data-filter-loc="al-ula"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          AlUla
        </button>
        <button
          data-filter-loc="jabal"
          class="filter-loc-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Area Perbukitan / Jabal
        </button>
      </div>

      <!-- Filter Tipe -->
      <div id="type-filter-container" class="flex flex-wrap items-center justify-center gap-2">
        <button
          data-filter-type="all"
          class="filter-type-btn active-pill px-4 py-1.5 rounded-full text-xs border border-[#4a88bc] bg-[#4a88bc] text-white transition-all shadow-sm cursor-pointer"
        >
          Semua Tipe
        </button>
        <button
          data-filter-type="single"
          class="type-photo-btn filter-type-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Single
        </button>
        <button
          data-filter-type="couple"
          class="type-photo-btn filter-type-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Couple
        </button>
        <button
          data-filter-type="family"
          class="type-photo-btn filter-type-btn px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Family
        </button>
        <button
          data-filter-type="cinematic"
          class="type-video-btn filter-type-btn hidden px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Cinematic
        </button>
        <button
          data-filter-type="testimonial"
          class="type-video-btn filter-type-btn hidden px-4 py-1.5 rounded-full text-xs border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-[#4a88bc] transition-all cursor-pointer"
        >
          Testimonial
        </button>
      </div>
    </div>

    <!-- Carousel -->
    <div class="relative max-w-5xl mx-auto h-[480px] md:h-[540px] flex items-center justify-center">
      <div id="gallery-carousel" class="w-full h-full relative flex items-center justify-center overflow-hidden">
        {portfolioItems.map((item, index) => (
          <div
            data-index={index}
            data-media={item.media}
            data-loc={item.location}
            data-type={item.type}
            data-image={item.image || ""}
            data-title={item.title}
            data-tag={item.tag}
            data-video-url={item.videoUrl || ""}
            data-video-provider={item.videoProvider || "mp4"}
            class="gallery-card absolute transition-all duration-500 ease-out cursor-pointer rounded-3xl overflow-hidden shadow-2xl border border-slate-200/60 dark:border-slate-800 select-none bg-slate-900 group"
            style="width: 280px; height: 420px;"
          >
            {item.media === "video" ? (
              <>
                <video
                  data-src={item.videoUrl}
                  loop
                  muted
                  playsinline
                  preload="none"
                  class="w-full h-full object-cover pointer-events-none"
                />
                <div class="play-trigger-btn absolute inset-0 flex items-center justify-center bg-slate-950/20 group-hover:bg-slate-950/40 transition-all z-10">
                  <div class="w-14 h-14 rounded-full bg-slate-900/70 backdrop-blur-md border border-white/30 flex items-center justify-center text-white shadow-xl transform group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              </>
            ) : (
              <>
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/30 transition-all flex items-center justify-center z-10">
                  <div class="w-10 h-10 rounded-full bg-slate-900/70 backdrop-blur-md border border-white/30 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                    </svg>
                  </div>
                </div>
              </>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 w-max max-w-[90%] text-center pointer-events-none">
              {/* <span class="inline-block px-3.5 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-md border border-white/20 text-[10px] font-semibold uppercase tracking-widest text-white shadow-lg">
                {item.tag}
              </span> */}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Carousel Controls -->
    <div class="flex items-center justify-center gap-8 mt-6">
      <button
        id="prev-btn"
        type="button"
        class="flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 hover:text-[#4a88bc] transition-colors cursor-pointer"
      >
        <div class="w-12 h-12 rounded-full border border-slate-300 dark:border-slate-800 flex items-center justify-center group-hover:border-[#4a88bc] group-hover:bg-[#4a88bc] group-hover:text-white transition-all shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-widest"> PREVIOUS </span>
      </button>
      <div id="carousel-dots" class="flex items-center gap-2"></div>
      <button
        id="next-btn"
        type="button"
        class="flex flex-col items-center gap-1 group text-slate-600 dark:text-slate-400 hover:text-[#4a88bc] transition-colors cursor-pointer"
      >
        <div class="w-12 h-12 rounded-full border border-slate-300 dark:border-slate-800 flex items-center justify-center group-hover:border-[#4a88bc] group-hover:bg-[#4a88bc] group-hover:text-white transition-all shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-widest"> NEXT </span>
      </button>
    </div>
  </div>
</section>

<!-- Image Fullscreen Lightbox Modal -->
<div
  id="image-modal"
  class="fixed inset-0 z-50 hidden opacity-0 flex flex-col items-center justify-center p-4 md:p-8 bg-slate-950/90 backdrop-blur-md transition-opacity duration-300"
>
  <button
    id="close-image-modal-btn"
    type="button"
    class="absolute top-6 right-6 z-50 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md text-white flex items-center justify-center transition-colors cursor-pointer"
    aria-label="Close modal"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <!-- Navigation inside Lightbox -->
  <button
    id="modal-prev-img"
    type="button"
    class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-50 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md text-white flex items-center justify-center transition-colors cursor-pointer"
    aria-label="Previous image"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <button
    id="modal-next-img"
    type="button"
    class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-50 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md text-white flex items-center justify-center transition-colors cursor-pointer"
    aria-label="Next image"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <div class="relative max-w-5xl max-h-[85vh] w-full flex flex-col items-center justify-center space-y-4">
    <img id="modal-image-view" src="" alt="Full View" class="max-h-[75vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl transition-all duration-300" />
    <div class="text-center text-white space-y-1 max-w-xl">
      <h3 id="modal-image-title" class="text-lg md:text-xl font-bold tracking-tight"></h3>
      <span id="modal-image-tag" class="inline-block px-3 py-1 rounded-full bg-white/10 text-[10px] font-semibold uppercase tracking-widest text-[#4a88bc]"></span>
    </div>
  </div>
</div>

<!-- Video Modal -->
<div
  id="video-modal"
  class="fixed inset-0 z-50 hidden opacity-0 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md transition-opacity duration-300"
>
  <div class="relative w-full max-w-[380px] md:max-w-[420px] aspect-[9/16] max-h-[88vh] rounded-3xl overflow-hidden shadow-2xl border border-white/20 bg-slate-900 flex items-center justify-center transform scale-95 transition-transform duration-300">
    <button
      id="close-modal-btn"
      type="button"
      class="absolute top-4 right-4 z-30 w-10 h-10 rounded-full bg-black/40 hover:bg-black/70 backdrop-blur-md border border-white/20 flex items-center justify-center text-white transition-colors cursor-pointer"
      aria-label="Close video"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <video id="modal-video-player" controls playsinline preload="none" class="w-full h-full object-contain rounded-3xl"></video>
  </div>
</div>

<script>
  function initGallery() {
    const carousel = document.getElementById("gallery-carousel");
    if (!carousel || carousel.dataset.initialized === "true") return;
    carousel.dataset.initialized = "true";

    let activeIndex = 0;
    let visibleCards: HTMLElement[] = [];
    const cards = Array.from(carousel.querySelectorAll(".gallery-card")) as HTMLElement[];

    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const dotsContainer = document.getElementById("carousel-dots");

    // Video Modal Elements
    const videoModal = document.getElementById("video-modal");
    const modalVideoPlayer = document.getElementById("modal-video-player") as HTMLVideoElement | null;
    const closeModalBtn = document.getElementById("close-modal-btn");

    // Image Lightbox Modal Elements
    const imageModal = document.getElementById("image-modal");
    const modalImageView = document.getElementById("modal-image-view") as HTMLImageElement | null;
    const modalImageTitle = document.getElementById("modal-image-title");
    const modalImageTag = document.getElementById("modal-image-tag");
    const closeImageModalBtn = document.getElementById("close-image-modal-btn");
    const modalPrevImg = document.getElementById("modal-prev-img");
    const modalNextImg = document.getElementById("modal-next-img");

    if (!cards.length) return;

    function stopCardVideos() {
      cards.forEach((card) => {
        const video = card.querySelector("video") as HTMLVideoElement | null;
        video?.pause();
      });
    }

    function getActiveFilter(selector: string, attribute: string, fallback: string) {
      return document.querySelector(`${selector}.active-pill`)?.getAttribute(attribute) || fallback;
    }

    function filterAndRender() {
      const activeMedia = document.querySelector(".filter-media-btn.active-media")?.getAttribute("data-filter-media") || "foto";
      const activeLoc = getActiveFilter(".filter-loc-btn", "data-filter-loc", "all");
      const activeType = getActiveFilter(".filter-type-btn", "data-filter-type", "all");

      document.querySelectorAll(".type-photo-btn").forEach((btn) => {
        btn.classList.toggle("hidden", activeMedia === "video");
      });
      document.querySelectorAll(".type-video-btn").forEach((btn) => {
        btn.classList.toggle("hidden", activeMedia !== "video");
      });

      stopCardVideos();

      visibleCards = cards.filter((card) => {
        const mediaMatch = card.dataset.media === activeMedia;
        const locMatch = activeLoc === "all" || card.dataset.loc === activeLoc;
        const typeMatch = activeType === "all" || card.dataset.type === activeType;
        return mediaMatch && locMatch && typeMatch;
      });

      cards.forEach((card) => {
        card.style.display = "none";
        card.style.opacity = "0";
      });

      activeIndex = 0;
      if (visibleCards.length === 0) {
        if (dotsContainer) dotsContainer.innerHTML = "";
        return;
      }

      renderCarousel();
      renderDots();
    }

    function renderCarousel() {
      if (!visibleCards.length) return;
      activeIndex = ((activeIndex % visibleCards.length) + visibleCards.length) % visibleCards.length;

      visibleCards.forEach((card, idx) => {
        card.style.display = "block";
        let offset = idx - activeIndex;

        const half = Math.floor(visibleCards.length / 2);
        if (offset < -half) {
          offset += visibleCards.length;
        } else if (offset > half) {
          offset -= visibleCards.length;
        }

        const videoElem = card.querySelector("video") as HTMLVideoElement | null;

        if (offset === 0) {
          card.style.transform = "translateX(0%) scale(1.15)";
          card.style.zIndex = "30";
          card.style.opacity = "1";
          card.style.filter = "brightness(100%)";

          if (videoElem) {
            if (!videoElem.src && videoElem.dataset.src) {
              videoElem.src = videoElem.dataset.src;
            }
            videoElem.muted = true;
            videoElem.playsInline = true;
            videoElem.play().catch(() => {});
          }
        } else {
          if (offset === -1) {
            card.style.transform = "translateX(-75%) scale(0.85)";
            card.style.zIndex = "20";
            card.style.opacity = "0.6";
            card.style.filter = "brightness(60%)";
          } else if (offset === 1) {
            card.style.transform = "translateX(75%) scale(0.85)";
            card.style.zIndex = "20";
            card.style.opacity = "0.6";
            card.style.filter = "brightness(60%)";
          } else {
            card.style.transform = `translateX(${offset * 100}%) scale(0.5)`;
            card.style.zIndex = "10";
            card.style.opacity = "0";
            card.style.filter = "brightness(60%)";
          }

          if (videoElem) videoElem.pause();
        }
      });
    }

    function renderDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = "";

      visibleCards.forEach((_, idx) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Tampilkan kartu ${idx + 1}`);
        dot.className =
          "h-1.5 rounded-full transition-all duration-300 cursor-pointer " +
          (idx === activeIndex ? "w-6 bg-[#4a88bc]" : "w-1.5 bg-slate-300 dark:bg-slate-700");

        dot.addEventListener("click", () => {
          if (idx === activeIndex) return;
          activeIndex = idx;
          renderCarousel();
          renderDots();
        });
        dotsContainer.appendChild(dot);
      });
    }

    function goToCard(direction: number) {
      if (visibleCards.length <= 1) return;
      activeIndex = (activeIndex + direction + visibleCards.length) % visibleCards.length;
      renderCarousel();
      renderDots();
    }

    // Modal Video (Full Screen & Audio Active)
    function openVideoModal(url: string) {
      if (!videoModal || !modalVideoPlayer) return;
      stopCardVideos();

      modalVideoPlayer.src = url;
      modalVideoPlayer.muted = false;
      modalVideoPlayer.currentTime = 0;
      modalVideoPlayer.play().catch(() => {});

      videoModal.classList.remove("hidden");
      requestAnimationFrame(() => {
        videoModal.classList.remove("opacity-0");
        const contentBox = videoModal.querySelector("div");
        contentBox?.classList.remove("scale-95");
        contentBox?.classList.add("scale-100");
      });
    }

    function closeVideoModal() {
      if (!videoModal || !modalVideoPlayer) return;
      const contentBox = videoModal.querySelector("div");
      contentBox?.classList.remove("scale-100");
      contentBox?.classList.add("scale-95");
      videoModal.classList.add("opacity-0");

      window.setTimeout(() => {
        videoModal.classList.add("hidden");
        modalVideoPlayer.pause();
        modalVideoPlayer.removeAttribute("src");
        modalVideoPlayer.load();
        renderCarousel();
      }, 300);
    }

    // Modal Lightbox Foto Fullscreen
    function openImageModal(index: number) {
      if (!imageModal || !modalImageView || !visibleCards[index]) return;
      const card = visibleCards[index];
      const imgUrl = card.dataset.image || "";
      const title = card.dataset.title || "";
      // const tag = card.dataset.tag || "";

      modalImageView.src = imgUrl;
      if (modalImageTitle) modalImageTitle.textContent = title;
      // if (modalImageTag) modalImageTag.textContent = tag;

      imageModal.classList.remove("hidden");
      requestAnimationFrame(() => {
        imageModal.classList.remove("opacity-0");
      });
    }

    function closeImageModal() {
      if (!imageModal) return;
      imageModal.classList.add("opacity-0");
      window.setTimeout(() => {
        imageModal.classList.add("hidden");
      }, 300);
    }

    // Event Listener Klik Kartu (Video vs Foto)
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const media = card.dataset.media;
        if (media === "video" && card.dataset.videoUrl) {
          openVideoModal(card.dataset.videoUrl);
        } else if (media === "foto") {
          const cardIdx = visibleCards.indexOf(card);
          if (cardIdx !== -1) {
            activeIndex = cardIdx;
            renderCarousel();
            renderDots();
            openImageModal(cardIdx);
          }
        }
      });
    });

    closeModalBtn?.addEventListener("click", closeVideoModal);
    videoModal?.addEventListener("click", (e) => {
      if (e.target === videoModal) closeVideoModal();
    });

    closeImageModalBtn?.addEventListener("click", closeImageModal);
    imageModal?.addEventListener("click", (e) => {
      if (e.target === imageModal) closeImageModal();
    });

    modalPrevImg?.addEventListener("click", (e) => {
      e.stopPropagation();
      goToCard(-1);
      openImageModal(activeIndex);
    });

    modalNextImg?.addEventListener("click", (e) => {
      e.stopPropagation();
      goToCard(1);
      openImageModal(activeIndex);
    });

    // Event Filter Media
    document.querySelectorAll(".filter-media-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        document.querySelectorAll(".filter-media-btn").forEach((b) => {
          b.classList.remove("active-media", "bg-[#4a88bc]", "text-white", "shadow-md");
          b.classList.add("text-slate-600", "dark:text-slate-400");
        });
        target.classList.add("active-media", "bg-[#4a88bc]", "text-white", "shadow-md");

        document.querySelectorAll(".filter-type-btn").forEach((b) => {
          b.classList.remove("active-pill", "bg-[#4a88bc]", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        document.querySelector('.filter-type-btn[data-filter-type="all"]')?.classList.add("active-pill", "bg-[#4a88bc]", "text-white");

        filterAndRender();
      });
    });

    // Event Filter Lokasi
    document.querySelectorAll(".filter-loc-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        document.querySelectorAll(".filter-loc-btn").forEach((b) => {
          b.classList.remove("active-pill", "bg-[#4a88bc]", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        target.classList.add("active-pill", "bg-[#4a88bc]", "text-white");
        filterAndRender();
      });
    });

    // Event Filter Tipe
    document.querySelectorAll(".filter-type-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        document.querySelectorAll(".filter-type-btn").forEach((b) => {
          b.classList.remove("active-pill", "bg-[#4a88bc]", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        target.classList.add("active-pill", "bg-[#4a88bc]", "text-white");
        filterAndRender();
      });
    });

    // Navigasi
    prevBtn?.addEventListener("click", () => goToCard(-1));
    nextBtn?.addEventListener("click", () => goToCard(1));

    // Keyboard ESC
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (videoModal && !videoModal.classList.contains("hidden")) closeVideoModal();
        if (imageModal && !imageModal.classList.contains("hidden")) closeImageModal();
      }
    });

    filterAndRender();
  }

  document.addEventListener("astro:page-load", initGallery);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery, { once: true });
  } else {
    initGallery();
  }
</script>