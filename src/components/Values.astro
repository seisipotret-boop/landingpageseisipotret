---
// src/components/Values.astro

const values = [
  {
    title: "Amanah",
    description:
      "Menjaga kepercayaan dalam setiap momen. Setiap perjalanan adalah cerita yang personal. Kami menjaganya dengan penuh tanggung jawab, menghormati privasi, kenyamanan, dan kepercayaan setiap jamaah.",
    icon: `M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z`,
  },
  {
    title: "Ihsan",
    description:
      "Memberikan yang terbaik dalam setiap karya. Kami mengutamakan kualitas visual, ketelitian, dan rasa dalam setiap foto maupun video agar setiap kenangan tersimpan dengan indah dan bermakna.",
    icon: `M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z`,
  },
  {
    title: "Khidmat",
    description:
      "Melayani tanpa mengurangi kekhusyukan. Melayani tanpa mengurangi kekhusyukan. Kami hadir dengan pendekatan yang tenang dan tidak mengganggu, agar jamaah tetap dapat fokus menjalani ibadah sementara setiap momen penting tetap terdokumentasi.",
    icon: `M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z`,
  },
];
---

<section class="py-20 bg-slate-100/60 dark:bg-slate-900/40 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="text-center max-w-xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-[#4a88bc]">
        NILAI KAMI
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white mt-2">
        Nilai Yang <span class="text-[#4a88bc]">Menghidupkan</span> Kami
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {values.map((item) => (
        <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-md transition duration-300">
          <div class="w-12 h-12 rounded-2xl bg-[#4a88bc]/10 text-[#4a88bc] flex items-center justify-center mb-6">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                d={item.icon}
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3">
            {item.title}
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-light leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
