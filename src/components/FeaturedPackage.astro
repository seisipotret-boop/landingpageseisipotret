---
// src/components/FeaturedPackage.astro

const packageDetails = {
  category: "PAKET SPESIAL SOLO",
  title: "Makkah Moment",
  subtitle:
    "Sesi dokumentasi foto personal eksklusif khusus perorangan di spot-spot ikonik pilihan Makkah dengan hasil profesional, aesthetic, dan natural.",
  price: "159 SAR",
  priceIDR: "Rp 763.200",
  unit: "/ Single Session (Max. 1 Person)",
  bookingLink: "/layanan/pelataran-makkah",
  otherServicesLink: "#lokasi",
  features: [
    "Photo Session Only",
    "30 - 45 Minutes Photo Session",
    "Pilih 1 Spot Dokumentasi",
    "Selected & Professionally Edited Photos",
    "Seluruh Original Photos selama sesi",
    "Pose & Angle Direction selama sesi",
    "Rekomendasi waktu terbaik untuk sesi",
  ],
  locations: [
    "Courtyard",
    "Mathaf Ka'bah",
    "Jabal Omar",
    "Jabal Kudai",
    "Jabal Khandamah",
  ],
  image:
    "https://raw.githubusercontent.com/seisipotret-boop/seisipotret-galeri/refs/heads/main/Pelataran_Makkah_Clock_Tower.png?q=80&w=800&auto=format&fit=crop",
};
---

<section id="paket" class="py-20 bg-slate-100/50 dark:bg-slate-900/50 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Grid 12 Kolom yang responsif -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- KIRI DESKTOP (order-1 di mobile, order-1 di desktop) -->
      <div class="order-1 lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#4a88bc]">
            {packageDetails.category}
          </span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white mt-2">
            {packageDetails.title}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-3 font-light leading-relaxed">
            {packageDetails.subtitle}
          </p>

          <!-- Available Locations Badge Grid -->
          <div class="mt-5 space-y-2.5">
            <span class="text-xs font-bold uppercase tracking-wider text-[#4a88bc] block">
              PILIHAN LOKASI TERSEDIA:
            </span>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
              {packageDetails.locations.map((loc) => (
                <div class="p-2.5 rounded-2xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 flex items-center gap-2 shadow-sm">
                  <span class="p-1 rounded-full bg-[#4a88bc]/10 text-[#4a88bc] shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    </svg>
                  </span>
                  <span class="text-xs font-bold text-slate-800 dark:text-slate-200 truncate">
                    {loc}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Detail disembunyikan di mobile agar urutannya menyatu setelah gambar -->
        <div class="hidden lg:block space-y-6 pt-2">
          <!-- Pricing -->
          <div class="flex items-baseline gap-2">
            <span class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white">
              {packageDetails.price}
            </span>
            <span class="text-sm text-[#4a88bc] font-bold">
              ({packageDetails.priceIDR})
            </span>
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">
              {packageDetails.unit}
            </span>
          </div>

          <!-- Features Checklist -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {packageDetails.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-xs text-slate-700 dark:text-slate-300 font-medium">
                <span class="p-0.5 rounded-full bg-[#4a88bc]/10 text-[#4a88bc] shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <!-- Action Buttons (Desktop) -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href={packageDetails.bookingLink}
              class="inline-flex items-center gap-3 bg-[#4a88bc] hover:bg-[#3b719f] text-white px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 cursor-pointer"
            >
              <span>Booking Sekarang</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a
              href={packageDetails.otherServicesLink}
              class="inline-flex items-center gap-2 bg-transparent hover:bg-slate-200/50 dark:hover:bg-slate-800 text-slate-900 dark:text-white px-6 py-4 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 border border-slate-300 dark:border-slate-700 cursor-pointer"
            >
              <span>Paket Lainnya</span>
            </a>
          </div>
        </div>
      </div>

      <!-- KANAN DESKTOP / TENGAH MOBILE (order-2 di mobile) -->
      <div class="order-2 lg:col-span-6 relative">
        <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-slate-200/60 dark:border-slate-800 aspect-[4/5] max-w-md mx-auto lg:max-w-none">
          <img
            src={packageDetails.image}
            alt="Makkah Moment Session"
            class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
        </div>
      </div>

      <!-- KETIGA MOBILE ONLY (order-3 di mobile) -->
      <div class="order-3 lg:hidden space-y-6">
        <!-- Pricing -->
        <div class="flex items-baseline gap-2 flex-wrap">
          <span class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white">
            {packageDetails.price}
          </span>
          <span class="text-sm text-[#4a88bc] font-bold">
            ({packageDetails.priceIDR})
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium block w-full mt-1">
            {packageDetails.unit}
          </span>
        </div>

        <!-- Features Checklist -->
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          {packageDetails.features.map((feature) => (
            <li class="flex items-start gap-2.5 text-xs text-slate-700 dark:text-slate-300 font-medium">
              <span class="p-0.5 rounded-full bg-[#4a88bc]/10 text-[#4a88bc] shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
              </span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <!-- Action Buttons (Mobile) -->
        <div class="pt-4 flex flex-col gap-3">
          <a
            href={packageDetails.bookingLink}
            class="inline-flex items-center justify-center gap-3 bg-[#4a88bc] hover:bg-[#3b719f] text-white px-8 py-4 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 cursor-pointer w-full"
          >
            <span>Booking Sekarang</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a
            href={packageDetails.otherServicesLink}
            class="inline-flex items-center justify-center gap-2 bg-transparent hover:bg-slate-200/50 dark:hover:bg-slate-800 text-slate-900 dark:text-white px-6 py-4 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-300 border border-slate-300 dark:border-slate-700 cursor-pointer w-full"
          >
            <span>Paket Lainnya</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>