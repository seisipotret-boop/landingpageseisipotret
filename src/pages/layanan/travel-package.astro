---
// src/pages/layanan/travel-package.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Travel Package";
const basePriceSAR = 1800; // Untuk 10 Hari (180 SAR/day base average)
const dailyRateSAR = 200;  // Per hari tambahan/dasar
const kursSAR = 4500;

const galleryImages = [
  {
    url: "https://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=800&auto=format&fit=crophttps://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=800&auto=format&fit=crop",
    title: "Full Trip Documentation",
    desc: "Dokumentasi menyeluruh dari kedatangan hingga kepulangan"
  },
  {
    url: "https://images.pexels.com/photos/15369686/pexels-photo-15369686.jpeg?q=80&w=800&auto=format&fit=crop?q=80&w=1200&auto=format&fit=crop",
    title: "Ibadah & Ziarah",
    desc: "Merekam momen hangat saat ibadah Umroh dan City Tour"
  },
  {
    url: "https://images.pexels.com/photos/36557800/pexels-photo-36557800.jpeg?q=80&w=800&auto=format&fit=cropq=80&w=1200&auto=format&fit=crop",
    title: "City Tour Madinah & Makkah",
    desc: "Pendampingan visual profesional di setiap destinasi bersejarah"
  }
];

const itineraryHighlights = [
  "Kedatangan (Bandara & Hotel)",
  "Ziarah Seputar Masjid Nabawi",
  "Raudhah (Jika ada tasreh)",
  "City Tour Madinah",
  "Umroh Wajib",
  "City Tour Makkah + Umroh ke-2",
  "City Tour Tambahan & Kepulangan (By Request)"
];

const includes = [
  "Dokumentasi Full Trip Menggunakan Kamera Profesional",
  "Pendampingan Fotografer / Videografer berpengalaman",
  "Unlimited Raw Photos & Videos",
  "Highlight Editing Video & Foto Pilihan"
];

const excludes = [
  "Transportasi selama di Saudi",
  "Penginapan / Hotel",
  "Visa & Tiket Masuk Destinasi Berbayar"
];
---

<Layout title={`${pageTitle} - Seisipotret Documentation`}>
  <Navbar />
  
  <main class="bg-white dark:bg-slate-950 transition-colors duration-300">
    
    <!-- 1. FULLSCREEN HERO SECTION -->
    <section class="relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden">
      <!-- Background Image & Overlay -->
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-100/60 via-slate-100/80 to-slate-50 dark:from-slate-950/70 dark:via-slate-950/85 dark:to-slate-950 z-10"></div>
        <img 
          src="https://myvitamine.co.id/assets/article/image/kabah.webp?q=80&w=1920&auto=format&fit=crop" 
          alt="Travel Package Background" 
          class="w-full h-full object-cover object-center filter blur-[1px]"
        />
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center space-y-6">
        <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-[#4a88bc] block">
          SEISI POTRET - Layanan Dokumentasi Profesional di Tanah Suci
        </span>

        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Travel Package
        </h1>

        <p class="text-base md:text-lg text-slate-700 dark:text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
          Dokumentasi perjalanan Umroh & Ziarah secara privat dan personal. Tim kami siap mendampingi seluruh rangkaian perjalanan Anda dari kedatangan hingga kepulangan.
        </p>

        <!-- Action Button -->
        <div class="pt-2">
          <a 
            href="#main-booking-section" 
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[#4a88bc] hover:bg-[#3b72a0] text-white font-medium text-sm transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 cursor-pointer"
          >
            <span>Konsultasi Perjalanan</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>

        <!-- Scroll Indicator -->
        <div class="pt-8 flex flex-col items-center justify-center gap-2 opacity-70 animate-bounce">
          <span class="text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400">Scroll Ke Bawah</span>
          <svg class="w-4 h-4 text-[#4a88bc]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>
    </section>

    <!-- 2. MAIN CONTENT SECTION -->
    <section id="main-booking-section" class="py-20 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          
          <!-- LEFT COLUMN (Span 7) -->
          <div class="lg:col-span-7 space-y-8">
            
            <!-- Subheader -->
            <div>
              <h2 class="text-2xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight uppercase">
                PENDAMPINGAN FULL TRIP
              </h2>
              
              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-3 mb-3">
                <a href="/#layanan" class="hover:text-[#4a88bc] transition flex items-center gap-1">
                  <span>← Layanan</span>
                </a>
                <span>/</span>
                <span class="text-slate-900 dark:text-white font-bold">{pageTitle}</span>
              </div>

              <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base font-light leading-relaxed">
                Layanan khusus untuk Anda yang menginginkan seluruh momen spiritual selama di Saudi terdokumentasi rapi. Kami menyesuaikan dengan agenda itinerary travel/pribadi Anda selama 10 hari, 14 hari, atau sesuai kebutuhan.
              </p>
            </div>

            <!-- Slider Galeri Foto -->
            <div class="space-y-2">
              <span class="text-[10px] font-bold text-[#4a88bc] uppercase tracking-widest block">
                DOKUMENTASI PERJALANAN
              </span>

              <div class="relative rounded-3xl overflow-hidden shadow-lg aspect-4/3 sm:aspect-16/10 bg-slate-900 group">
                <div id="main-slider" class="w-full h-full flex transition-transform duration-500 ease-out">
                  {galleryImages.map((img) => (
                    <div 
                      class="slider-item w-full h-full shrink-0 relative cursor-pointer"
                      data-img-url={img.url}
                      data-img-title={img.title}
                    >
                      <img src={img.url} alt={img.title} class="w-full h-full object-cover" />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
                    </div>
                  ))}
                </div>

                <div class="absolute top-4 right-4 z-10 px-3 py-1 rounded-full bg-slate-950/50 backdrop-blur-md text-[11px] font-medium text-white tracking-wider">
                  <span id="slider-current-index">1</span> / {galleryImages.length}
                </div>

                <button id="prev-btn" aria-label="Previous" class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-slate-950/40 hover:bg-slate-950/70 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                </button>

                <button id="next-btn" aria-label="Next" class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-slate-950/40 hover:bg-slate-950/70 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                </button>

                <div id="slider-dots" class="absolute bottom-4 left-0 right-0 z-10 flex justify-center items-center gap-1.5">
                  {galleryImages.map((_, i) => (
                    <button class={`slider-dot rounded-full transition-all duration-300 ${i === 0 ? 'bg-[#4a88bc] w-5 h-1.5' : 'bg-white/60 w-1.5 h-1.5'}`} data-index={i} aria-label={`Slide ${i + 1}`}></button>
                  ))}
                </div>
              </div>
            </div>

            <!-- Coverage Agenda Highlight -->
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
              <h3 class="text-base font-bold text-slate-900 dark:text-white uppercase tracking-wider">
                Cakupan Agenda Perjalanan (Coverage)
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {itineraryHighlights.map((item, idx) => (
                  <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
                    <span class="w-6 h-6 rounded-full bg-[#4a88bc]/10 text-[#4a88bc] font-bold text-xs flex items-center justify-center shrink-0">
                      {idx + 1}
                    </span>
                    <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- INCLUDE & EXCLUDE SECTION (Menggantikan posisi Notes) -->
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-6">
              
              <!-- INCLUDE -->
              <div class="space-y-3">
                <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                  <div class="p-1.5 rounded-xl bg-emerald-500/10">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <h3 class="text-sm font-bold uppercase tracking-wider">Sudah Termasuk (Include)</h3>
                </div>
                <ul class="space-y-2 pl-2">
                  {includes.map((inc) => (
                    <li class="flex items-start gap-2.5 text-xs text-slate-600 dark:text-slate-300">
                      <span class="text-emerald-500 font-bold">•</span>
                      <span>{inc}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="border-t border-slate-100 dark:border-slate-800"></div>

              <!-- EXCLUDE -->
              <div class="space-y-3">
                <div class="flex items-center gap-2 text-rose-500 dark:text-rose-400">
                  <div class="p-1.5 rounded-xl bg-rose-500/10">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                  </div>
                  <h3 class="text-sm font-bold uppercase tracking-wider">Tidak Termasuk (Exclude)</h3>
                </div>
                <ul class="space-y-2 pl-2">
                  {excludes.map((exc) => (
                    <li class="flex items-start gap-2.5 text-xs text-slate-600 dark:text-slate-300">
                      <span class="text-rose-500 font-bold">•</span>
                      <span>{exc}</span>
                    </li>
                  ))}
                </ul>
              </div>

            </div>

          </div>

          <!-- RIGHT COLUMN (Span 5): Sticky Direct WhatsApp Booking Form -->
          <div class="lg:col-span-5 sticky top-28">
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 md:p-8 border border-slate-200/80 dark:border-slate-800 shadow-lg space-y-6">
              
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">Konsultasi & Booking Trip</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-light mt-1">
                  Atur jadwal perjalanan Anda langsung bersama Admin
                </p>
              </div>

              <!-- Price Info Card -->
              <div class="p-4 rounded-2xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800/80 dark:to-slate-800/40 border border-slate-200/60 dark:border-slate-700/60 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-500 dark:text-slate-400">Paket Dasar (10 Hari):</span>
                  <span class="text-base font-extrabold text-slate-900 dark:text-white">{basePriceSAR} SAR</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-xs text-slate-500 dark:text-slate-400">Tarif Per Hari Tambahan:</span>
                  <span class="text-xs font-bold text-[#4a88bc]">{dailyRateSAR} SAR / Day</span>
                </div>
                <div class="pt-2 border-t border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
                  <span class="text-[11px] text-slate-400">Estimasi Kurs SAR:</span>
                  <span class="text-[11px] text-slate-400">1 SAR = Rp {kursSAR.toLocaleString('id-ID')}</span>
                </div>
              </div>

              <!-- Interactive Days Selector & Form -->
              <form id="travel-booking-form" class="space-y-4">
                
                <div>
                  <label for="fullName" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">
                    NAMA LENGKAP
                  </label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                    </span>
                    <input 
                      type="text" 
                      id="fullName" 
                      required 
                      placeholder="Nama Anda / Perwakilan Travel" 
                      class="w-full pl-10 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-transparent focus:border-[#4a88bc] text-xs text-slate-900 dark:text-white placeholder-slate-400 outline-none transition"
                    />
                  </div>
                </div>

                <div>
                  <label for="tripDays" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">
                    ESTIMASI DURASI TRIP (HARI)
                  </label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </span>
                    <input 
                      type="number" 
                      id="tripDays" 
                      min="1" 
                      value="10" 
                      required 
                      class="w-full pl-10 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-transparent focus:border-[#4a88bc] text-xs text-slate-900 dark:text-white outline-none transition font-bold"
                    />
                  </div>
                </div>

                <div>
                  <label for="startDate" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">
                    TANGGAL KEDATANGAN / MULAI
                  </label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                    </span>
                    <input 
                      type="date" 
                      id="startDate" 
                      required 
                      class="w-full pl-10 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-transparent focus:border-[#4a88bc] text-xs text-slate-900 dark:text-white outline-none transition"
                    />
                  </div>
                </div>

                <!-- Calculated Estimate Display -->
                <div class="p-3 bg-[#4a88bc]/10 rounded-2xl border border-[#4a88bc]/20 flex items-center justify-between">
                  <span class="text-xs text-[#4a88bc] font-medium">Estimasi Biaya:</span>
                  <div class="text-right">
                    <span id="estimated-price-sar" class="text-sm font-extrabold text-[#4a88bc] block leading-none">1800 SAR</span>
                    <span id="estimated-price-idr" class="text-[10px] text-slate-500 dark:text-slate-400 block mt-0.5">± Rp 8.100.000</span>
                  </div>
                </div>

                <div class="pt-2">
                  <button 
                    type="submit" 
                    class="w-full py-4 rounded-2xl bg-[#4a88bc] hover:bg-[#3b72a0] text-white font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 cursor-pointer transition-all shadow-md"
                  >
                    <span>HUBUNGI ADMIN VIA WHATSAPP</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </button>
                </div>
              </form>

            </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md hidden flex-col items-center justify-center p-4 md:p-8 opacity-0 transition-opacity duration-300">
    <button id="lightbox-close" aria-label="Close modal" class="absolute top-6 right-6 text-white/80 hover:text-white p-3 rounded-full bg-white/10 backdrop-blur-md transition cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="max-w-4xl w-full flex flex-col items-center text-center space-y-4">
      <img id="lightbox-img" src="" alt="Full Preview" class="max-h-[80vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl" />
      <h3 id="lightbox-title" class="text-xl font-bold text-white"></h3>
    </div>
  </div>

  <CTASection />
  <Footer />
</Layout>

<script is:inline>
  function initPageScript() {
    // 1. AUTOMATIC SLIDER LOGIC
    const slider = document.getElementById('main-slider');
    const sliderItems = document.querySelectorAll('.slider-item');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const dots = document.querySelectorAll('.slider-dot');
    const currentIndexDisplay = document.getElementById('slider-current-index');
    
    let currentIndex = 0;
    const totalItems = sliderItems.length;
    let slideTimer;

    const updateSlider = (index) => {
      currentIndex = (index + totalItems) % totalItems;
      if (slider) slider.style.transform = `translateX(-${currentIndex * 100}%)`;
      if (currentIndexDisplay) currentIndexDisplay.textContent = currentIndex + 1;

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.className = "slider-dot rounded-full bg-[#4a88bc] w-5 h-1.5 transition-all duration-300";
        } else {
          dot.className = "slider-dot rounded-full bg-white/60 w-1.5 h-1.5 transition-all duration-300";
        }
      });
    };

    const startAutoSlide = () => {
      stopAutoSlide();
      slideTimer = setInterval(() => {
        updateSlider(currentIndex + 1);
      }, 3500);
    };

    const stopAutoSlide = () => {
      if (slideTimer) clearInterval(slideTimer);
    };

    prevBtn?.addEventListener('click', () => {
      updateSlider(currentIndex - 1);
      startAutoSlide();
    });

    nextBtn?.addEventListener('click', () => {
      updateSlider(currentIndex + 1);
      startAutoSlide();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.dataset.index || "0");
        updateSlider(idx);
        startAutoSlide();
      });
    });

    startAutoSlide();

    // 2. LIGHTBOX MODAL
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img');
    const modalTitle = document.getElementById('lightbox-title');
    const modalClose = document.getElementById('lightbox-close');

    sliderItems.forEach(item => {
      item.addEventListener('click', () => {
        stopAutoSlide();
        const url = item.dataset.imgUrl;
        const title = item.dataset.imgTitle;

        if (modalImg && modalTitle && modal) {
          modalImg.src = url;
          modalTitle.textContent = title;
          modal.classList.remove('hidden');
          setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }
      });
    });

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        startAutoSlide();
      }, 300);
    };

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // 3. DYNAMIC PRICE CALCULATION
    const tripDaysInput = document.getElementById('tripDays');
    const priceSarDisplay = document.getElementById('estimated-price-sar');
    const priceIdrDisplay = document.getElementById('estimated-price-idr');
    const kurs = 4500;

    const calculatePrice = () => {
      const days = parseInt(tripDaysInput.value) || 10;
      let totalSAR = 0;

      if (days <= 10) {
        // Base rate untuk 10 hari 1800 SAR (180 SAR/day)
        totalSAR = Math.max(days * 180, 1800);
      } else {
        // 1800 SAR + 200 SAR per hari setelahnya
        totalSAR = 1800 + ((days - 10) * 200);
      }

      const totalIDR = totalSAR * kurs;

      if (priceSarDisplay) priceSarDisplay.textContent = `${totalSAR} SAR`;
      if (priceIdrDisplay) priceIdrDisplay.textContent = `± Rp ${totalIDR.toLocaleString('id-ID')}`;
      return { days, totalSAR };
    };

    tripDaysInput?.addEventListener('input', calculatePrice);

    // 4. WHATSAPP FORM SUBMISSION TEMPLATE
    const form = document.getElementById('travel-booking-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = document.getElementById('fullName').value.trim();
      const startDate = document.getElementById('startDate').value;
      const { days, totalSAR } = calculatePrice();

      if (!name || !startDate) {
        alert("Harap isi nama dan tanggal kedatangan Anda.");
        return;
      }

      const phoneNumber = "6281122806660";
      const message = `Halo Admin Seisipotret, Saya ingin berkonsultasi & memesan Travel Package (Full Trip).

Nama : ${name}
Layanan : Travel Package (Full Trip)
Mulai / Kedatangan : ${startDate}
Durasi Perjalanan : ${days} Hari
