---
// src/pages/layanan/alula.astro
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import CTASection from "../../components/CTASection.astro";
import Footer from "../../components/Footer.astro";

const pageTitle = "AlUla";
const kursSAR = 4800;

// Harga Dasar & Biaya Tambahan
const basePriceSAR = 3390;
const additionalPaxPriceSAR = 450;
const marayaPriceSAR = 350;
const habitasPriceSAR = 350;

const galleryImages = [
  {
    url: "/media/layanan/alula1.webp?q=80&w=800&auto=format&fit=crop",
    title: "Elephant Rock AlUla",
    desc: "Keajaiban batu raksasa berbentuk gajah ikonik di gurun AlUla",
  },
  {
    url: "https://images.pexels.com/photos/15369686/pexels-photo-15369686.jpeg?q=80&w=800&auto=format&fit=crop",
    title: "AlUla Old Town",
    desc: "Suasana bersejarah kota tua AlUla dengan arsitektur klasik",
  },
  {
    url: "https://images.pexels.com/photos/11181577/pexels-photo-11181577.jpeg?q=80&w=800&auto=format&fit=crop",
    title: "Shalal Cafe",
    desc: "Spot eksotis bersantai di antara lanskap tebing AlUla",
  },
];

const includedLocations = ["Elephant Rock", "Old Town AlUla", "Shalal Cafe"];

const packageIncludes = [
  "Fasilitas Transportasi Mobil GMC Premium",
  "Peruntukan Single / Couple",
  "1 Edited Video Sinematik (45 - 60 Detik)",
  "Editing Foto Profesional",
  "Unlimited Foto & Video (Raw Files)",
];

const optionalAddons = [
  { id: "maraya", name: "Kunjungan Maraya Concert Hall", priceSAR: 350 },
  { id: "habitas", name: "Kunjungan Resort Habitas AlUla", priceSAR: 350 },
];
---

<Layout title={`${pageTitle} - Seisipotret Documentation`}>
  <Navbar />

  <main class="bg-white dark:bg-slate-950 transition-colors duration-300">
    <!-- 1. FULLSCREEN HERO SECTION -->
    <section class="relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-100/60 via-slate-100/80 to-slate-50 dark:from-slate-950/70 dark:via-slate-950/85 dark:to-slate-950 z-10"></div>
        <img
          src="https://images.pexels.com/photos/35531111/pexels-photo-35531111.jpeg?q=80&w=1920&auto=format&fit=crop"
          alt="AlUla Background"
          class="w-full h-full object-cover object-center filter blur-[1px]"
        />
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center space-y-6">
        <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-[#4a88bc] block">
          SEISI POTRET - Layanan Dokumentasi Profesional di Tanah Suci
        </span>

        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl text-slate-900 dark:text-white uppercase tracking-tight leading-tight sm:leading-tight mb-4 md:mb-6">
          AlUla
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-slate-700 dark:text-slate-300 max-w-2xl mx-auto font-light leading-relaxed mb-6 md:mb-8">
          Nikmati perjalanan dokumentasi eksklusif menjelajahi keajaiban gurun
          AlUla paket terlengkap untuk momen tak terlupakan Anda.
        </p>

        <div class="pt-2">
          <a
            href="#main-booking-section"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-[#4a88bc] hover:bg-[#3b72a0] text-white font-medium text-sm transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 cursor-pointer"
          >
            <span>Pesan Paket Sekarang</span>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              ></path>
            </svg>
          </a>
        </div>

        <div class="pt-8 flex flex-col items-center justify-center gap-2 opacity-70 animate-bounce">
          <span class="text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400">
            Scroll Ke Bawah
          </span>
          <svg
            class="w-4 h-4 text-[#4a88bc]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"
            ></path>
          </svg>
        </div>
      </div>
    </section>

    <!-- 2. MAIN CONTENT SECTION -->
    <section id="main-booking-section" class="py-20 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <!-- LEFT COLUMN (Span 7): Detail Paket Lengkap -->
          <div class="lg:col-span-7 space-y-8">
            <div>
              <h2 class="text-2xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight uppercase">
                PILIH PAKET & LOKASI
              </h2>

              <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-3 mb-3">
                <a
                  href="/#layanan"
                  class="hover:text-[#4a88bc] transition flex items-center gap-1"
                >
                  <span>← Layanan</span>
                </a>
                <span>/</span>
                <span class="text-slate-900 dark:text-white font-bold">
                  {pageTitle}
                </span>
              </div>

              <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base font-light leading-relaxed">
                Paket all-in-one perjalanan foto & video profesional di AlUla.
                Sudah mencakup semua fasilitas lokasi favorit dan kenyamanan
                armada GMC selama perjalanan.
              </p>
            </div>

            <!-- Slider Galeri Foto Destinasi AlUla -->
            <div class="space-y-2">
              <span class="text-[10px] font-bold text-[#4a88bc] uppercase tracking-widest block">
                PREVIEW DESTINASI ALULA
              </span>

              <div class="relative rounded-3xl overflow-hidden shadow-lg aspect-4/3 sm:aspect-16/10 bg-slate-900 group">
                <div
                  id="main-slider"
                  class="w-full h-full flex transition-transform duration-500 ease-out"
                >
                  {galleryImages.map((img) => (
                    <div
                      class="slider-item w-full h-full shrink-0 relative cursor-pointer"
                      data-img-url={img.url}
                      data-img-title={img.title}
                    >
                      <img
                        src={img.url}
                        alt={img.title}
                        class="w-full h-full object-cover"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
                      <div class="absolute bottom-6 left-6 right-6 text-white">
                        <h4 class="font-bold text-lg">{img.title}</h4>
                        <p class="text-xs text-slate-300 font-light">
                          {img.desc}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="absolute top-4 right-4 z-10 px-3 py-1 rounded-full bg-slate-950/50 backdrop-blur-md text-[11px] font-medium text-white tracking-wider">
                  <span id="slider-current-index">1</span> /{" "}
                  {galleryImages.length}
                </div>

                <button
                  id="prev-btn"
                  aria-label="Previous image"
                  class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-slate-950/40 hover:bg-slate-950/70 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M15 19l-7-7 7-7"
                    ></path>
                  </svg>
                </button>

                <button
                  id="next-btn"
                  aria-label="Next image"
                  class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-slate-950/40 hover:bg-slate-950/70 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer"
                >
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M9 5l7 7-7 7"
                    ></path>
                  </svg>
                </button>

                <div
                  id="slider-dots"
                  class="absolute bottom-4 left-0 right-0 z-10 flex justify-center items-center gap-1.5"
                >
                  {galleryImages.map((_, i) => (
                    <button
                      class={`slider-dot rounded-full transition-all duration-300 ${i === 0 ? "bg-[#4a88bc] w-5 h-1.5" : "bg-white/60 w-1.5 h-1.5"}`}
                      data-index={i}
                      aria-label={`Slide ${i + 1}`}
                    ></button>
                  ))}
                </div>
              </div>
            </div>
<!-- TAMPILAN DETAIL LENGKAP PAKET (DIRECT DISPLAY) -->
<div class="bg-white dark:bg-slate-900 rounded-3xl p-6 md:p-8 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-6">
  
  <!-- Header Paket & Harga -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-100 dark:border-slate-800">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-[#4a88bc]">
        DOKUMENTASI EKSKLUSIF
      </span>
      <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1">
        AlUla
      </h3>
    </div>

    <div class="text-right">
      <span class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white block leading-none">
        {basePriceSAR} SAR
      </span>
      <span class="text-xs text-slate-400 font-light block mt-1">
        ± Rp {(basePriceSAR * kursSAR).toLocaleString("id-ID")}
      </span>
    </div>
  </div>

  <!-- Lokasi Kunjungan Terdaftar -->
  <div class="space-y-3">
    <h4 class="text-xs font-bold uppercase tracking-wider text-[#4a88bc]">
      LOKASI DESTINASI OTOMATIS TERMASUK:
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {includedLocations.map((loc) => (
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-800 flex items-center gap-2.5">
          <span class="p-1 rounded-full bg-[#4a88bc]/10 text-[#4a88bc] shrink-0">
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
            </svg>
          </span>
          <span class="text-xs font-bold text-slate-800 dark:text-slate-200">
            {loc}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- List Include -->
  <div class="space-y-3 pt-2">
    <h4 class="text-xs font-bold uppercase tracking-wider text-[#4a88bc]">
      FASILITAS & DOKUMENTASI TERMASUK (INCLUDE):
    </h4>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {packageIncludes.map((inc) => (
        <li class="flex items-start gap-2.5 text-xs text-slate-700 dark:text-slate-300 font-medium">
          <span class="p-0.5 rounded-full bg-[#4a88bc]/10 text-[#4a88bc] shrink-0 mt-0.5">
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
          </span>
          <span>{inc}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Additional Pax Note (Minimalist Layout) -->
  <!-- Catatan & Ketentuan Paket (Box Format) -->
<div class="pt-2">
  <div class="bg-slate-50 dark:bg-slate-800/40 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
    <div class="flex items-center gap-2 text-[#4a88bc]">
      <svg
        class="w-5 h-5 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0"
        ></path>
      </svg>
      <h3 class="text-sm font-bold uppercase tracking-wider">
        Catatan & Ketentuan Paket
      </h3>
    </div>
    <ul class="space-y-2 pl-1">
      <li class="flex items-start gap-2 text-xs text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
        <span class="text-[#4a88bc] font-bold">•</span>
        <span>
          Biaya di atas berlaku untuk kapasitas standar Single/Couple
        </span>
      </li>
      <li class="flex items-start gap-2 text-xs text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
        <span class="text-[#4a88bc] font-bold">•</span>
        <span>
          Tambahan peserta akan dikenakan biaya <strong class="text-slate-800 dark:text-slate-200 font-semibold">+{additionalPaxPriceSAR} SAR / Person</strong>.
        </span>
      </li>
    </ul>
  </div>
</div>

</div>
          </div>

          <!-- RIGHT COLUMN (Span 5): Sticky Booking & Option Panel -->
          <div class="lg:col-span-5 sticky top-28">
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 md:p-8 border border-slate-200/80 dark:border-slate-800 shadow-lg space-y-6">
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  Booking Details
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 font-light mt-1">
                  Lengkapi data pemesanan dan kustomisasi peserta tambahan di
                  bawah ini.
                </p>
              </div>

              <form id="booking-form" class="space-y-5">
                <!-- Nama Lengkap -->
                <div>
                  <label
                    for="fullName"
                    class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5"
                  >
                    NAMA LENGKAP
                  </label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                        ></path>
                      </svg>
                    </span>
                    <input
                      type="text"
                      id="fullName"
                      required
                      placeholder="Nama Anda"
                      class="w-full pl-10 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-transparent focus:border-[#4a88bc] text-xs text-slate-900 dark:text-white placeholder-slate-400 outline-none transition"
                    />
                  </div>
                </div>

                <!-- Tanggal Sesi -->
                <div>
                  <label
                    for="sessionDate"
                    class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5"
                  >
                    TANGGAL SESI
                  </label>
                  <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path>
                      </svg>
                    </span>
                    <input
                      type="date"
                      id="sessionDate"
                      required
                      class="w-full pl-10 pr-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-transparent focus:border-[#4a88bc] text-xs text-slate-900 dark:text-white outline-none transition"
                    />
                  </div>
                </div>

                <!-- Additional Pax Selector -->
                <div>
                  <label
                    for="additionalPax"
                    class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5"
                  >
                    TAMBAHAN PESERTA (ADDITIONAL PAX)
                  </label>
                  <div class="flex items-center gap-3">
                    <select
                      id="additionalPax"
                      class="w-full px-4 py-3.5 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-transparent focus:border-[#4a88bc] text-xs font-semibold text-slate-900 dark:text-white outline-none transition cursor-pointer"
                    >
                      <option value="0">Tidak ada (+0 SAR)</option>
                      <option value="1">+1 Person (+450 SAR)</option>
                      <option value="2">+2 Person (+900 SAR)</option>
                      <option value="3">+3 Person (+1.350 SAR)</option>
                      <option value="4">+4 Person (+1.800 SAR)</option>
                    </select>
                  </div>
                </div>

                <!-- Additional Destinasi (Exclude Optional) -->
                <div class="pt-2 space-y-2">
                  <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    LOKASI OPSIONAL TAMBAHAN (EXCLUDE LIST)
                  </label>

                  {optionalAddons.map((addon) => (
                    <label class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800 cursor-pointer hover:border-[#4a88bc] transition">
                      <div class="flex items-center gap-3">
                        <input
                          type="checkbox"
                          value={addon.id}
                          data-price={addon.priceSAR}
                          data-name={addon.name}
                          class="addon-checkbox w-4 h-4 rounded text-[#4a88bc] focus:ring-[#4a88bc] accent-[#4a88bc] cursor-pointer"
                        />
                        <span class="text-xs font-medium text-slate-800 dark:text-slate-200">
                          {addon.name}
                        </span>
                      </div>
                      <span class="text-xs font-bold text-[#4a88bc]">
                        +{addon.priceSAR} SAR
                      </span>
                    </label>
                  ))}
                </div>

                <!-- Total Kalkulasi Box -->
                <div class="p-4 rounded-2xl bg-slate-100/80 dark:bg-slate-800/80 border border-slate-200/50 dark:border-slate-700/50 space-y-2">
                  <div class="flex justify-between items-center text-xs text-slate-500 dark:text-slate-400">
                    <span>Paket Dasar (Single/Couple):</span>
                    <span class="font-bold text-slate-900 dark:text-white">
                      {basePriceSAR} SAR
                    </span>
                  </div>

                  <div
                    id="pax-summary-row"
                    class="hidden justify-between items-center text-xs text-slate-500 dark:text-slate-400"
                  >
                    <span id="pax-summary-text">Tambahan Pax:</span>
                    <span
                      id="pax-summary-price"
                      class="font-bold text-slate-900 dark:text-white"
                    >
                      +0 SAR
                    </span>
                  </div>

                  <div
                    id="addon-summary-row"
                    class="hidden justify-between items-center text-xs text-slate-500 dark:text-slate-400"
                  >
                    <span>Opsional Addon:</span>
                    <span
                      id="addon-summary-price"
                      class="font-bold text-slate-900 dark:text-white"
                    >
                      +0 SAR
                    </span>
                  </div>

                  <div class="pt-2 border-t border-slate-200 dark:border-slate-700 flex justify-between items-baseline">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                      TOTAL ESTIMASI:
                    </span>
                    <div class="text-right">
                      <span
                        id="total-price-sar"
                        class="text-xl font-extrabold text-[#4a88bc] block"
                      >
                        {basePriceSAR} SAR
                      </span>
                      <span
                        id="total-price-idr"
                        class="text-[10px] text-slate-400 block font-light"
                      >
                        ± Rp {(basePriceSAR * kursSAR).toLocaleString("id-ID")}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                  <button
                    type="submit"
                    id="submit-btn"
                    class="w-full py-4 rounded-2xl bg-[#4a88bc] hover:bg-[#3b72a0] text-white font-bold text-xs uppercase tracking-widest flex items-center justify-center gap-2 cursor-pointer transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
                  >
                    <span>KIRIM BOOKING KE WHATSAPP</span>
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      ></path>
                    </svg>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Lightbox Modal Fullscreen -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md hidden flex-col items-center justify-center p-4 md:p-8 opacity-0 transition-opacity duration-300"
  >
    <button
      id="lightbox-close"
      aria-label="Close modal"
      class="absolute top-6 right-6 text-white/80 hover:text-white p-3 rounded-full bg-white/10 backdrop-blur-md transition cursor-pointer"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
    <div class="max-w-4xl w-full flex flex-col items-center text-center space-y-4">
      <img
        id="lightbox-img"
        src=""
        alt="Full Preview"
        class="max-h-[80vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl"
      />
      <h3 id="lightbox-title" class="text-xl font-bold text-white"></h3>
    </div>
  </div>

  <CTASection />
  <Footer />
</Layout>

<script>
  let slideTimer: ReturnType<typeof setInterval> | null = null;
  const BASE_PRICE = 3390;
  const ADD_PAX_PRICE = 450;
  const KURS = 4800;

  function initPageScript() {
    // 1. AUTOMATIC SLIDER LOGIC
    const slider = document.getElementById("main-slider");
    const sliderItems = document.querySelectorAll(".slider-item");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const dots = document.querySelectorAll(".slider-dot");
    const currentIndexDisplay = document.getElementById("slider-current-index");

    let currentIndex = 0;
    const totalItems = sliderItems.length;

    const stopAutoSlide = () => {
      if (slideTimer) {
        clearInterval(slideTimer);
        slideTimer = null;
      }
    };

    const updateSlider = (index: number) => {
      if (totalItems === 0) return;
      currentIndex = (index + totalItems) % totalItems;
      if (slider)
        slider.style.transform = `translateX(-${currentIndex * 100}%)`;
      if (currentIndexDisplay)
        currentIndexDisplay.textContent = (currentIndex + 1).toString();

      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.className =
            "slider-dot rounded-full bg-[#4a88bc] w-5 h-1.5 transition-all duration-300";
        } else {
          dot.className =
            "slider-dot rounded-full bg-white/60 w-1.5 h-1.5 transition-all duration-300";
        }
      });
    };

    const startAutoSlide = () => {
      stopAutoSlide();
      if (totalItems > 0) {
        slideTimer = setInterval(() => {
          updateSlider(currentIndex + 1);
        }, 3500);
      }
    };

    if (prevBtn) {
      prevBtn.onclick = () => {
        updateSlider(currentIndex - 1);
        startAutoSlide();
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        updateSlider(currentIndex + 1);
        startAutoSlide();
      };
    }

    dots.forEach((dot) => {
      (dot as HTMLElement).onclick = (e) => {
        const target = e.currentTarget as HTMLElement;
        const idx = parseInt(target.dataset.index || "0", 10);
        updateSlider(idx);
        startAutoSlide();
      };
    });

    startAutoSlide();

    // 2. LIGHTBOX MODAL
    const modal = document.getElementById("lightbox-modal");
    const modalImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;
    const modalTitle = document.getElementById("lightbox-title");
    const modalClose = document.getElementById("lightbox-close");

    sliderItems.forEach((item) => {
      (item as HTMLElement).onclick = () => {
        stopAutoSlide();
        const element = item as HTMLElement;
        const url = element.dataset.imgUrl || "";
        const title = element.dataset.imgTitle || "";

        if (modalImg && modalTitle && modal) {
          modalImg.src = url;
          modalTitle.textContent = title;
          modal.classList.remove("hidden");
          setTimeout(() => modal.classList.remove("opacity-0"), 10);
        }
      };
    });

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add("opacity-0");
      setTimeout(() => {
        modal.classList.add("hidden");
        startAutoSlide();
      }, 300);
    };

    if (modalClose) modalClose.onclick = closeModal;
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };
    }

    // 3. KALKULASI HARGA REAL-TIME
    const paxSelect = document.getElementById(
      "additionalPax",
    ) as HTMLSelectElement;
    const addonCheckboxes = document.querySelectorAll(
      ".addon-checkbox",
    ) as NodeListOf<HTMLInputElement>;

    const paxSummaryRow = document.getElementById("pax-summary-row");
    const paxSummaryText = document.getElementById("pax-summary-text");
    const paxSummaryPrice = document.getElementById("pax-summary-price");

    const addonSummaryRow = document.getElementById("addon-summary-row");
    const addonSummaryPrice = document.getElementById("addon-summary-price");

    const totalPriceSarEl = document.getElementById("total-price-sar");
    const totalPriceIdrEl = document.getElementById("total-price-idr");

    const updateCalculator = () => {
      const extraPaxCount = parseInt(paxSelect?.value || "0", 10);
      const extraPaxCost = extraPaxCount * ADD_PAX_PRICE;

      let addonCost = 0;
      addonCheckboxes.forEach((cb) => {
        if (cb.checked) {
          addonCost += parseInt(cb.dataset.price || "0", 10);
        }
      });

      // Update UI Row Additional Pax
      if (extraPaxCount > 0) {
        paxSummaryRow?.classList.remove("hidden");
        paxSummaryRow?.classList.add("flex");
        if (paxSummaryText)
          paxSummaryText.textContent = `Tambahan ${extraPaxCount} Pax:`;
        if (paxSummaryPrice)
          paxSummaryPrice.textContent = `+${extraPaxCost} SAR`;
      } else {
        paxSummaryRow?.classList.add("hidden");
        paxSummaryRow?.classList.remove("flex");
      }

      // Update UI Row Addons
      if (addonCost > 0) {
        addonSummaryRow?.classList.remove("hidden");
        addonSummaryRow?.classList.add("flex");
        if (addonSummaryPrice)
          addonSummaryPrice.textContent = `+${addonCost} SAR`;
      } else {
        addonSummaryRow?.classList.add("hidden");
        addonSummaryRow?.classList.remove("flex");
      }

      // Total Calculation
      const grandTotal = BASE_PRICE + extraPaxCost + addonCost;
      if (totalPriceSarEl)
        totalPriceSarEl.textContent = `${grandTotal.toLocaleString("id-ID")} SAR`;
      if (totalPriceIdrEl)
        totalPriceIdrEl.textContent = `± Rp ${(grandTotal * KURS).toLocaleString("id-ID")}`;
    };

    if (paxSelect) paxSelect.onchange = updateCalculator;
    addonCheckboxes.forEach((cb) => {
      cb.onchange = updateCalculator;
    });

    // 4. SUBMIT FORM TO WHATSAPP
    const form = document.getElementById("booking-form") as HTMLFormElement;
    if (form) {
      form.onsubmit = (e) => {
        e.preventDefault();

        const nameInput = document.getElementById(
          "fullName",
        ) as HTMLInputElement;
        const dateInput = document.getElementById(
          "sessionDate",
        ) as HTMLInputElement;

        const name = nameInput?.value.trim() || "";
        const date = dateInput?.value || "";

        if (!name || !date) {
          alert("Harap isi nama dan tanggal sesi Anda.");
          return;
        }

        const extraPaxCount = parseInt(paxSelect?.value || "0", 10);
        const extraPaxCost = extraPaxCount * ADD_PAX_PRICE;

        const selectedAddons: string[] = [];
        let addonCost = 0;
        addonCheckboxes.forEach((cb) => {
          if (cb.checked) {
            const addonName = cb.dataset.name || "";
            const price = cb.dataset.price || "0";
            selectedAddons.push(`${addonName} (+${price} SAR)`);
            addonCost += parseInt(price, 10);
          }
        });

        const grandTotal = BASE_PRICE + extraPaxCost + addonCost;
        const phoneNumber = "6285163096956";

        let message = `Halo Admin Seisipotret, Saya ingin memesan paket dokumentasi AlUla.

Nama : ${name}
Package : Full Package AlUla (Single / Couple)
Tanggal Sesi : ${date}

Lokasi Destinasi Standard (Included):
- Elephant Rock
- Old Town AlUla
- Shalal Cafe

Rincian Pemesanan:
- Paket Dasar : ${BASE_PRICE} SAR`;

        if (extraPaxCount > 0) {
          message += `\n- Tambahan Peserta : +${extraPaxCount} Person (+${extraPaxCost} SAR)`;
        } else {
          message += `\n- Tambahan Peserta : Tidak Ada`;
        }

        if (selectedAddons.length > 0) {
          message += `\n- Add-on Opsional :\n  * ${selectedAddons.join("\n  * ")}`;
        }

        message += `\n\nTotal Biaya : ${grandTotal} SAR (± Rp ${(grandTotal * KURS).toLocaleString("id-ID")})

Mohon konfirmasi ketersediaan armada GMC dan jadwal. Terima kasih.`;

        window.open(
          `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`,
          "_blank",
        );
      };
    }
  }

  document.addEventListener("astro:page-load", initPageScript);
  document.addEventListener("astro:before-preparation", () => {
    if (slideTimer) {
      clearInterval(slideTimer);
      slideTimer = null;
    }
  });
</script>
