---
// src/pages/kontak.astro
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import CTASection from "../components/CTASection.astro";
import Footer from "../components/Footer.astro";

const contactCards = [
  {
    label: "WHATSAPP",
    value: "+6285163096956 (Admin Seisipotret)",
    href: "https://wa.me/6285163096956?text=Halo%20Seisipotret,%20saya%20ingin%20konsultasi%20dokumentasi%20umroh",
    icon: `M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z`,
    highlight: true,
  },
  {
    label: "EMAIL",
    value: "seisipotret@gmail.com",
    href: "mailto:seisipotret@gmail.com",
    icon: `M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z`,
    highlight: false,
  },
  {
    label: "INSTAGRAM",
    value: "@seisipotret.co",
    href: "https://instagram.com/seisipotret.co",
    icon: `M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z M15 13a3 3 0 11-6 0 3 3 0 016 0z`,
    highlight: false,
  },
  {
    label: "TIKTOK",
    value: "@seisipotret",
    href: "https://www.tiktok.com/@seisipotret",
    icon: `M19.59 6.69a4.83 4.83 0 01-3.77-4.11V2h-3.45v13.67a2.9 2.9 0 11-2.9-2.9c.3 0 .59.05.86.13V9.4a6.34 6.34 0 00-.86-.06A6.34 6.34 0 1015.82 15V8.42a8.16 8.16 0 004.77 1.52V6.69h-1z`,
    highlight: false,
  },
  {
    label: "AREA LAYANAN",
    value: "Mekkah, Madinah, Jeddah, AlUla, Thaif",
    href: null,
    icon: `M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z`,
    highlight: false,
  },
  {
    label: "JAM OPERASIONAL",
    value: "Senin - Sabtu, 08.00 - 20.00 WIB / AST",
    href: null,
    icon: `M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z`,
    highlight: false,
    fullWidth: true,
  },
];
---

<Layout title="Kontak Kami - Seisipotret Documentation">
  <Navbar />
  <main>
    <!-- 1. Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center pt-24 pb-16 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-100/60 via-slate-100/80 to-slate-50 dark:from-slate-950/70 dark:via-slate-950/85 dark:to-slate-950 z-10"></div>
        <img
          src="https://myvitamine.co.id/assets/article/image/kabah.webp?q=80&w=1920&auto=format&fit=crop"
          alt="Tanah Suci Background"
          class="w-full h-full object-cover object-center filter blur-[1px]"
        />
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <span class="text-xs md:text-sm font-bold uppercase tracking-widest text-[#4a88bc] block mb-3">
          KONTAK KAMI
        </span>
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl text-slate-900 dark:text-white uppercase tracking-tight leading-tight sm:leading-tight mb-4 md:mb-6">
          Mari Berbicara <span class="italic text-[#4a88bc]">Lebih Dekat</span>
        </h1>

        <p class="text-sm sm:text-base md:text-lg text-slate-700 dark:text-slate-300 max-w-2xl mx-auto font-light leading-relaxed mb-6 md:mb-8">
          Punya pertanyaan atau ingin konsultasi perjalanan spiritual Anda? Tim
          kami siap melayani Anda sepenuh hati.
        </p>

        <div class="pt-4 flex flex-col items-center justify-center gap-2 opacity-80 animate-bounce">
          <span class="text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400">
            Scroll Ke Bawah
          </span>
          <svg
            class="w-4 h-4 text-[#4a88bc]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"
            ></path>
          </svg>
        </div>
      </div>
    </section>

    <!-- 2. Main Contact Section -->
    <section class="py-20 bg-slate-100/50] dark:bg-slate-950 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-6 md:px-12 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <!-- Left Column: Deskripsi + Grid Card Kontak -->
          <div class="lg:col-span-6 space-y-8">
            <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 font-light leading-relaxed max-w-lg">
              Punya pertanyaan atau ingin konsultasi perjalanan spiritual Anda?
              Tim kami siap melayani Anda sepenuh hati.
            </p>

            <!-- Grid Kontak Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {contactCards.map((item) => (
                <div
                  class={`p-6 rounded-3xl transition duration-300 flex flex-col justify-between space-y-6 ${
                    item.fullWidth ? "sm:col-span-1" : ""
                  } ${
                    item.highlight
                      ? "bg-[#4a88bc]/10 dark:bg-[#4a88bc]/20 border border-[#4a88bc]/30 dark:border-[#4a88bc]/40"
                      : "bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800"
                  }`}
                >
                  <!-- Ikon Bulat -->
                  <div
                    class={`w-12 h-12 rounded-full flex items-center justify-center ${
                      item.highlight
                        ? "bg-[#4a88bc] text-white"
                        : "bg-[#4a88bc]/10 dark:bg-slate-800 text-[#4a88bc] dark:text-slate-300"
                    }`}
                  >
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.8"
                        d={item.icon}
                      ></path>
                    </svg>
                  </div>

                  <!-- Teks Label & Value -->
                  <div class="space-y-1">
                    <span class="text-[10px] font-bold tracking-widest text-slate-400 dark:text-slate-500 uppercase block">
                      {item.label}
                    </span>
                    {item.href ? (
                      <a
                        href={item.href}
                        target="_blank"
                        class="text-base font-bold text-slate-900 dark:text-white hover:text-[#4a88bc] transition block"
                      >
                        {item.value}
                      </a>
                    ) : (
                      <p class="text-base font-bold text-slate-900 dark:text-white leading-snug">
                        {item.value}
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Right Column: Interactive Map & Fast Response Card -->
          <div class="lg:col-span-6 space-y-6">
            <!-- Map Container -->
            <div class="relative overflow-hidden rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 h-[420px]">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14858.918991206144!2d39.821034!3d21.422487!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x15c21b4ced818775%3A0x98ab2469cf70c9ce!2sMasjidil%20Haram!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="w-full h-full filter contrast-[1.05] dark:brightness-90 dark:invert-[0.9] dark:hue-rotate-180 transition-all duration-300"
              ></iframe>
            </div>

            <!-- Fast Response Card (Bawah Map) -->
            <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
              <div class="space-y-1">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  Butuh Respon Cepat?
                </h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 font-light max-w-sm">
                  Chat via WhatsApp sekarang dan dapatkan balasan dalam hitungan
                  menit.
                </p>
              </div>
              <a
                href="https://wa.me/6285163096956?text=Halo%20Seisipotret,%20saya%20butuh%20respon%20cepat"
                target="_blank"
                class="inline-flex items-center gap-2 bg-[#4a88bc] hover:bg-[#3b72a0] text-white px-7 py-3.5 rounded-full text-sm font-medium transition shadow-md whitespace-nowrap shrink-0"
              >
                Chat Sekarang
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. CTA Section -->
    <CTASection />
  </main>
  <Footer />
</Layout>
