---
// src/pages/kebijakan-privasi.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const privacySections = [
  {
    title: "Informasi Yang Kami Kumpulkan",
    content: "Kami dapat mengumpulkan informasi pribadi seperti nama, nomor telepon, alamat email, dan detail perjalanan saat Anda menggunakan layanan kami atau mengisi formulir kontak."
  },
  {
    title: "Penggunaan Informasi",
    content: "Informasi yang kami kumpulkan digunakan untuk memproses pemesanan, memberikan layanan pelanggan, mengirimkan informasi terkait perjalanan Anda, dan meningkatkan kualitas layanan kami."
  },
  {
    title: "Perlindungan Data",
    content: "Kami mengimplementasikan langkah-langkah keamanan yang sesuai untuk melindungi data pribadi Anda dari akses, pengubahan, pengungkapan, atau penghancuran yang tidak sah."
  },
  {
    title: "Berbagi Informasi",
    content: "Kami tidak menjual atau menyewakan data pribadi Anda kepada pihak ketiga. Informasi Anda hanya dibagikan dengan mitra yang diperlukan untuk penyediaan layanan (seperti hotel, maskapai, atau vendor terkait)."
  },
  {
    title: "Perubahan Kebijakan",
    content: "Kami dapat memperbarui kebijakan privasi ini sewaktu-waktu. Perubahan akan diumumkan di situs web ini."
  }
];
---

<Layout title="Kebijakan Privasi - Haramain Services">
  <Navbar />

  <main class="bg-[#F7F9FB] dark:bg-slate-950 transition-colors duration-300 pt-32 pb-24">
    <div class="max-w-4xl mx-auto px-6 md:px-12 space-y-12">
      
      <!-- Header Section -->
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-[#4a88bc] block">
          LEGAL
        </span>
        <h1 class="text-3xl md:text-5xl font-semibold text-slate-900 dark:text-white tracking-tight">
          Kebijakan <span class="text-[#4a88bc] font-normal italic">Privasi</span>
        </h1>
        <p class="text-sm md:text-base text-slate-600 dark:text-slate-400 font-light leading-relaxed">
          SeisiPotret berkomitmen untuk melindungi privasi Anda. Kebijakan ini menjelaskan bagaimana kami mengumpulkan, menggunakan, dan melindungi data pribadi Anda.
        </p>
      </div>

      <!-- Content Sections -->
      <div class="space-y-10">
        {privacySections.map((section) => (
          <div class="space-y-2">
            <h2 class="text-lg md:text-xl font-semibold text-slate-900 dark:text-white tracking-tight">
              {section.title}
            </h2>
            <p class="text-sm md:text-base text-slate-600 dark:text-slate-400 font-light leading-relaxed">
              {section.content}
            </p>
          </div>
        ))}
      </div>

    </div>
  </main>

  <CTASection />
  <Footer />
</Layout>