---
import "../styles/global.css";
import FloatingWA from "../components/FloatingWA.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Seisipotret - Jasa Dokumentasi Jemaah Umroh VVIP",
  description = "Abadikan momen suci Anda di Tanah Suci dengan layanan dokumentasi profesional Seisipotret.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
    <!-- Script Deteksi Mode Awal -->
    <script is:inline>
      const applyTheme = () => {
        const theme = localStorage.getItem("theme");
        if (
          theme === "dark" ||
          (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      // Terapkan saat awal muat
      applyTheme();

      // Terapkan ulang saat navigasi Astro View Transitions
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300">
    <slot />
    <FloatingWA />
  </body>
</html>
